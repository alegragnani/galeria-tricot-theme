{%- comment -%}
  Product Card Snippet — Galeria Tricot (estilo BP)
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}

<div class="product-card">
  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" class="product-card__image-link">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | escape }}"
          class="product-card__image product-card__image--primary"
          loading="lazy"
          width="600"
          height="900"
        >
      {%- endif -%}

      {%- if product.images.size > 1 -%}
        <img
          src="{{ product.images[1] | image_url: width: 600 }}"
          alt="{{ product.images[1].alt | escape }}"
          class="product-card__image product-card__image--hover"
          loading="lazy"
          width="600"
          height="900"
        >
      {%- endif -%}
    </a>

    {%- if product.compare_at_price > product.price -%}
      {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <span class="product-card__badge product-card__badge--sale">- {{ discount }}%</span>
    {%- elsif product.metafields.custom.conjunto_pecas != blank -%}
      {%- comment -%} Conjunto: verificar se as pecas estao em sale {%- endcomment -%}
      {%- assign conj_pecas = product.metafields.custom.conjunto_pecas.value -%}
      {%- assign conj_compare_total = 0 -%}
      {%- assign conj_price_total = 0 -%}
      {%- assign conj_has_sale = false -%}
      {%- for peca in conj_pecas -%}
        {%- if peca.compare_at_price > peca.price -%}
          {%- assign conj_has_sale = true -%}
          {%- assign conj_compare_total = conj_compare_total | plus: peca.compare_at_price -%}
        {%- else -%}
          {%- assign conj_compare_total = conj_compare_total | plus: peca.price -%}
        {%- endif -%}
        {%- assign conj_price_total = conj_price_total | plus: peca.price -%}
      {%- endfor -%}
      {%- if conj_has_sale and conj_compare_total > conj_price_total -%}
        {%- assign conj_discount = conj_compare_total | minus: conj_price_total | times: 100 | divided_by: conj_compare_total -%}
        <span class="product-card__badge product-card__badge--sale">- {{ conj_discount }}%</span>
      {%- endif -%}
    {%- endif -%}

    <button class="product-card__wishlist" aria-label="Adicionar aos favoritos">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </button>

    <!-- Seletor de tamanho rapido — hover -->
    {%- assign is_conjunto = false -%}
    {%- assign title_lower = product.title | downcase -%}
    {%- if product.type == 'Conjuntos' or title_lower contains 'conjunto' or title_lower contains 'twin' -%}
      {%- assign is_conjunto = true -%}
    {%- endif -%}

    {%- if is_conjunto -%}
      {%- comment -%} Conjunto: botao que leva pra pagina do produto {%- endcomment -%}
      <a href="{{ product.url }}" class="product-card__quick-sizes product-card__quick-sizes--link">
        <span class="product-card__sizes-label">Selecionar tamanho</span>
      </a>
    {%- else -%}
      {%- comment -%} Peça avulsa: tamanhos direto no card {%- endcomment -%}
      <div class="product-card__quick-sizes">
        <span class="product-card__sizes-label">Selecionar tamanho</span>
        <div class="product-card__sizes-row">
          {%- for variant in product.variants -%}
            {%- assign size_label = variant.title -%}
            {%- if variant.available -%}
              <button
                class="product-card__size-btn"
                data-variant-id="{{ variant.id }}"
                data-url="{{ product.url }}"
                onclick="quickAddSize(this, event)"
              >{{ size_label }}</button>
            {%- else -%}
              <span class="product-card__size-btn product-card__size-btn--sold-out">{{ size_label }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    <a href="{{ product.url }}" class="product-card__title-link">
      <h3 class="product-card__title">{{ product.title }}</h3>
    </a>

    <div class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__price--compare">
          {{ product.compare_at_price | money }}
        </span>
        <span class="product-card__price--sale">
          {{ product.price | money }}
        </span>
      {%- elsif conj_has_sale and conj_compare_total > conj_price_total -%}
        <span class="product-card__price--compare">
          {{ conj_compare_total | money }}
        </span>
        <span class="product-card__price--sale">
          {{ conj_price_total | money }}
        </span>
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .product-card {
    position: relative;
  }

  .product-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: transparent;
  }

  .product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.4s ease;
  }

  .product-card__image--hover {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .product-card__image-wrapper:hover .product-card__image--hover {
    opacity: 1;
  }

  .product-card__image-wrapper:hover .product-card__image--primary {
    opacity: 0;
  }

  /* Badge de desconto */
  .product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    font-family: 'Raleway', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 4px 8px;
    background: #000;
    color: #fff;
  }

  /* Wishlist heart */
  .product-card__wishlist {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-card__image-wrapper:hover .product-card__wishlist {
    opacity: 1;
  }

  .product-card__wishlist svg {
    width: 20px;
    height: 20px;
    color: #545454;
  }

  /* Seletor de tamanho rapido — transparente sobre a imagem */
  .product-card__quick-sizes {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 12px 10px;
    background: rgba(255, 255, 255, 0.92);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .product-card__image-wrapper:hover .product-card__quick-sizes {
    opacity: 1;
  }

  .product-card__sizes-label {
    font-family: 'Raleway', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3px;
    color: #545454;
    margin-bottom: 4px;
  }

  .product-card__sizes-row {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .product-card__size-btn {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #121212;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    min-width: 35px;
    height: 30px;
    line-height: 30px;
    text-align: center;
    transition: color 0.15s ease, background 0.15s ease;
    position: relative;
  }

  .product-card__size-btn:hover {
    background: #B3883D;
    color: #ffffff;
  }
  .product-card__size-btn--sold-out:hover {
    background: none;
    color: #c0c0c0;
  }

  /* Tamanho selecionado — caixinha preenchida */
  .product-card__size-btn--sel,
  .product-card__size-btn--sel:hover {
    background: #B3883D;
    color: #ffffff;
  }

  /* Tamanho esgotado — riscado */
  .product-card__size-btn--sold-out {
    color: #c0c0c0;
    cursor: default;
    text-decoration: line-through;
  }

  /* Conjunto: botao unico que leva pra PDP */
  .product-card__quick-sizes--link {
    text-decoration: none;
    cursor: pointer;
    padding: 10px 12px;
  }

  .product-card__quick-sizes--link .product-card__sizes-label {
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    font-size: 12px;
    color: #121212;
    transition: color 0.15s ease;
  }

  .product-card__quick-sizes--link:hover .product-card__sizes-label {
    color: #B3883D;
  }

  /* Info: titulo + preco (BP specs) */
  .product-card__info {
    padding: 12px 0 0;
  }

  .product-card__title-link {
    text-decoration: none;
    color: inherit;
  }

  .product-card__title {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #121212;
    margin: 0 0 6px 0;
    line-height: 1.4;
  }

  .product-card__price {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #aaaaaa;
  }

  .product-card__price--compare {
    text-decoration: line-through;
    color: #cccccc;
    font-size: 14px;
    margin-right: 8px;
  }

  .product-card__price--sale {
    color: #c1673a;
  }

  /* Mobile: sem seletor de tamanho no card (cliente escolhe na pagina do produto) */
  @media (max-width: 768px) {
    .product-card__quick-sizes {
      display: none;
    }
    /* Medidas byNV mobile: imagem comprida (352px de altura, corte cover) */
    .product-card__image-wrapper {
      aspect-ratio: auto !important;
      height: 352px !important;
    }
    .product-card__image {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
    }
    /* Tipografia byNV: nome 16px regular #474745, preco 16px #474745 */
    .product-card__title {
      font-size: 16px;
      font-weight: 400;
      text-transform: none;
      letter-spacing: 0.2px;
      color: #474745;
    }
    .product-card__price {
      font-size: 16px;
      font-weight: 500;
      color: #474745;
    }
  }
</style>

<script>
function quickAddSize(btn, e) {
  e.preventDefault();
  e.stopPropagation();

  /* Clique no tamanho: abre a pagina do produto ja com o tamanho selecionado */
  var variantId = btn.getAttribute('data-variant-id');
  var url = btn.getAttribute('data-url') || '';
  if (!url) return;
  window.location.href = url.split('?')[0] + (variantId ? '?variant=' + variantId : '');
}
</script>
