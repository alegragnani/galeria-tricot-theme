<!-- Escolhas das Blogueiras — 2 banners retrato lado a lado (lookbook estilo BP) -->
<section class="lookbook">
  {% if section.settings.title != blank %}
    <div class="lookbook__header">
      <h2 class="lookbook__title">{{ section.settings.title }}</h2>
    </div>
  {% endif %}

  <div class="lookbook__grid">
    {% for block in section.blocks %}
      <div class="lookbook__item" {{ block.shopify_attributes }}>
        {% if block.settings.link %}<a href="{{ block.settings.link }}" class="lookbook__link">{% endif %}
          <div class="lookbook__image-wrapper">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 749px) 100vw, 50vw"
                alt="{{ block.settings.heading | escape }}"
                class="lookbook__image"
                loading="lazy"
              >
            {% else %}
              <div class="lookbook__placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.heading != blank or block.settings.cta_text != blank %}
              <div class="lookbook__overlay">
                <div class="lookbook__content">
                  {% if block.settings.heading != blank %}
                    <h3 class="lookbook__heading">{{ block.settings.heading }}</h3>
                  {% endif %}
                  {% if block.settings.cta_text != blank %}
                    <span class="lookbook__cta">{{ block.settings.cta_text }}</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% if block.settings.link %}</a>{% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .lookbook {
    padding: 24px 0;
    background-color: #ffffff;
  }

  .lookbook__header {
    text-align: center;
    margin-bottom: 2rem;
    padding: 0 2rem;
  }

  .lookbook__title {
    font-family: 'Italiana', 'Cormorant Garamond', Georgia, serif;
    font-size: 32px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #BC8E49;
    line-height: 1.3;
    margin: 0;
  }

  .lookbook__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .lookbook__item {
    overflow: hidden;
  }

  .lookbook__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .lookbook__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .lookbook__image,
  .lookbook__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .lookbook__link:hover .lookbook__image {
    transform: scale(1.05);
  }

  .lookbook__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 3rem 2rem;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 100%);
    display: flex;
    align-items: flex-end;
    z-index: 2;
  }

  .lookbook__content {
    color: #ffffff;
  }

  .lookbook__heading {
    font-family: 'Italiana', 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    line-height: 1.3;
    margin: 0 0 1rem 0;
  }

  .lookbook__cta {
    display: inline-flex;
    align-items: center;
    font-family: 'Raleway', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    border: 1px solid #ffffff;
    padding: 12px 28px;
    color: #ffffff;
    transition: all 0.3s ease;
  }

  .lookbook__link:hover .lookbook__cta {
    background-color: #ffffff;
    color: #545454;
  }

  /* Mobile: empilha 1 coluna */
  @media (max-width: 749px) {
    .lookbook__grid {
      grid-template-columns: 1fr;
    }

    .lookbook__image-wrapper {
      aspect-ratio: 3 / 4;
    }

    .lookbook__overlay {
      padding: 2rem 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Escolhas Blogueiras",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título da seção",
      "default": "ESCOLHAS DAS BLOGUEIRAS"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem",
          "info": "Retrato (9:16). Tamanho ideal: 900×1600px"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "NOME DA BLOGUEIRA"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Texto do botão",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Escolhas Blogueiras",
      "blocks": [
        {
          "type": "banner"
        },
        {
          "type": "banner"
        }
      ]
    }
  ]
}
{% endschema %}
