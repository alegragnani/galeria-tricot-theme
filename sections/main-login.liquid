{% comment %}
  Customer login section - main-login.liquid
{% endcomment %}

<div class="login-page">
  <div class="login-container">
    <div class="login-box">
      <h1 class="login-title">FAÇA LOGIN</h1>

      {% if shop.customer_accounts_enabled %}
        <form method="post" action="/account/login" class="login-form" novalidate>
          <div class="form-group">
            <label for="customer-email">E-mail *</label>
            <input
              type="email"
              name="customer[email]"
              id="customer-email"
              class="form-input"
              autocomplete="email"
              required
            />
          </div>

          <div class="form-group">
            <label for="customer-password">Senha *</label>
            <input
              type="password"
              name="customer[password]"
              id="customer-password"
              class="form-input"
              autocomplete="current-password"
              required
            />
          </div>

          <button type="submit" class="btn btn--primary">ENTRAR</button>
        </form>

        <div class="login-help">
          <a href="/account/recover">Esqueceu sua senha?</a>
        </div>

        <div class="login-divider">ou</div>

        <div class="register-prompt">
          <p>Ainda não é cliente?</p>
          <a href="/account/register" class="btn btn--secondary">CRIAR CONTA</a>
        </div>
      {% else %}
        <p>As contas de cliente estão desativadas neste momento.</p>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .login-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    background: #f9f9f9;
  }

  .login-container {
    width: 100%;
    max-width: 400px;
  }

  .login-box {
    background: #fff;
    border: 1px solid #e0e0e0;
    padding: 50px 30px;
  }

  .login-title {
    font-family: 'Italiana', 'Cormorant Garamond', Georgia, serif;
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 2px;
    margin: 0 0 30px 0;
    text-transform: uppercase;
    text-align: center;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }

  .form-input {
    padding: 12px;
    border: 1px solid #e0e0e0;
    font-size: 14px;
    transition: border-color 0.3s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #000;
  }

  .btn--primary {
    background: #000;
    color: #fff;
    border: none;
    padding: 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn--primary:hover {
    background: #333;
  }

  .login-help {
    text-align: center;
    margin-top: 15px;
  }

  .login-help a {
    font-size: 12px;
    color: #000;
    text-decoration: underline;
  }

  .login-help a:hover {
    color: #666;
  }

  .login-divider {
    text-align: center;
    margin: 30px 0;
    color: #999;
    font-size: 12px;
  }

  .register-prompt {
    text-align: center;
    padding-top: 30px;
    border-top: 1px solid #e0e0e0;
  }

  .register-prompt p {
    font-size: 14px;
    color: #666;
    margin: 0 0 15px 0;
  }

  .btn--secondary {
    display: block;
    background: transparent;
    border: 1px solid #000;
    padding: 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    color: #000;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn--secondary:hover {
    background: #000;
    color: #fff;
  }

  @media (max-width: 768px) {
    .login-page {
      padding: 30px 20px;
    }

    .login-box {
      padding: 30px 20px;
    }

    .login-title {
      font-size: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Login"
}
{% endschema %}
