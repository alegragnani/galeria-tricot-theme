<!-- Category Grid - 4 mini banners de categoria (estilo PatBO) -->
<section class="gt-cats">
  <ul class="gt-cats__grid">
    {% for block in section.blocks %}
      <li class="gt-cats__item" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link }}" class="gt-cats__link">
          <div class="gt-cats__image-wrapper">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 768px) 50vw, 25vw"
                alt="{{ block.settings.heading | escape }}"
                class="gt-cats__image"
                loading="lazy"
                width="800"
                height="1067"
              >
            {% else %}
              <div class="gt-cats__placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if block.settings.heading != blank %}
            <h3 class="gt-cats__heading">{{ block.settings.heading }}</h3>
          {% endif %}
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<style>
  .section-category-grid {
    display: block;
  }

  .gt-cats {
    padding: 0;
    margin: 0;
    background-color: #ffffff;
    display: block;
  }

  .gt-cats__grid {
    list-style: none;
    margin: 3px 0 0;
    padding: 0;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
  }

  .gt-cats__item {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  .gt-cats__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .gt-cats__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .gt-cats__image,
  .gt-cats__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .gt-cats__link:hover .gt-cats__image {
    transform: scale(1.05);
  }

  .gt-cats__heading {
    font-family: 'Raleway', -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #545454;
    text-align: center;
    margin: 24px 0 0;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .gt-cats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gt-cats__heading {
      font-size: 13px;
      margin: 18px 0 0;
    }
  }
</style>

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "class": "section-category-grid",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem (proporção 3:4 recomendada)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Nome da categoria",
          "default": "Categoria"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link da categoria"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { "type": "category", "settings": { "heading": "Conjuntos" } },
        { "type": "category", "settings": { "heading": "Casacos e Blusas" } },
        { "type": "category", "settings": { "heading": "Vestidos" } },
        { "type": "category", "settings": { "heading": "Macacão" } }
      ]
    }
  ]
}
{% endschema %}
