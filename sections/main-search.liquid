{%- comment -%} BUSCA-CATEGORIA (19/11/2026, pedido da Ale): quando a busca e SO a palavra de uma categoria (vestido, calca, blusa...), leva para a vitrine da categoria, que ja e organizada por lancamento/mais vendidos. Qualquer outra busca continua pura do Shopify. Para desligar: apagar este bloco ate FIM BUSCA-CATEGORIA. {%- endcomment -%}
{%- assign gt_termo = search.terms | replace: 'title:', '' | downcase | strip | replace: 'Ç', 'c' | replace: 'ç', 'c' | replace: 'Ã', 'a' | replace: 'ã', 'a' | replace: 'Õ', 'o' | replace: 'õ', 'o' -%}
{%- assign gt_destino = '' -%}
{%- case gt_termo -%}
  {%- when 'vestido', 'vestidos' -%}{%- assign gt_destino = 'roupas-vestidos' -%}
  {%- when 'calca', 'calcas' -%}{%- assign gt_destino = 'roupas-calcas' -%}
  {%- when 'blusa', 'blusas' -%}{%- assign gt_destino = 'roupas-blusas' -%}
  {%- when 'casaco', 'casacos' -%}{%- assign gt_destino = 'roupas-casacos' -%}
  {%- when 'conjunto', 'conjuntos' -%}{%- assign gt_destino = 'roupas-conjuntos' -%}
  {%- when 'saia', 'saias' -%}{%- assign gt_destino = 'roupas-saias' -%}
  {%- when 'short', 'shorts' -%}{%- assign gt_destino = 'roupas-shorts' -%}
  {%- when 'macacao', 'macacoes' -%}{%- assign gt_destino = 'roupas-macacoes' -%}
  {%- when 'capa', 'capas' -%}{%- assign gt_destino = 'roupas-capas' -%}
{%- endcase -%}
{%- if gt_destino != '' and collections[gt_destino].products_count > 0 -%}
<script>window.location.replace({{ collections[gt_destino].url | json }});</script>
<style>.search-results { display: none !important; }</style>
{%- endif -%}
{%- comment -%} FIM BUSCA-CATEGORIA {%- endcomment -%}
{%- comment -%} BUSCA-TITULO (20/11/2026, pedido da Ale: "quero que pare de mostrar resultados apos o fim da busca"): a busca passa a procurar a palavra SO NO NOME do produto (consulta title: do proprio Shopify). Ex.: "zara" mostra so as pecas Zara (com os Conjuntos) e nada depois. Se nao achar nada pelo nome, mostra a busca normal do Shopify (parametro gt=tudo). Para desligar: apagar este bloco ate FIM BUSCA-TITULO e voltar search.terms nos 3 lugares que usam gt_busca_txt. {%- endcomment -%}
{%- assign gt_busca_txt = search.terms | replace: 'title:', '' | strip -%}
{%- if search.performed and gt_destino == '' -%}
<script>
(function () {
  try {
    var p = new URLSearchParams(window.location.search);
    var q = (p.get('q') || '').trim();
    if (!q) return;
    var porTitulo = /(^|\s)title:/.test(q);
    var tudo = p.get('gt') === 'tudo';
    var total = {{ search.results_count | default: 0 }};
    var limpar = function (s) { return s.replace(/title:/g, '').replace(/\s+/g, ' ').trim(); };
    if (!porTitulo && !tudo) {
      var palavras = q.split(/\s+/).map(function (w) { return w.replace(/[:"()*]/g, ''); }).filter(function (w) { return w.length > 0; });
      if (!palavras.length) return;
      document.documentElement.classList.add('gt-busca-trocando');
      p.set('q', palavras.map(function (w) { return 'title:' + w; }).join(' ')); p.set('type', 'product'); p.delete('page');
      window.location.replace('/search?' + p.toString());
      return;
    }
    if (porTitulo && total === 0 && !tudo) {
      document.documentElement.classList.add('gt-busca-trocando');
      p.set('q', limpar(q)); p.set('gt', 'tudo'); p.delete('page');
      window.location.replace('/search?' + p.toString());
      return;
    }
    if (document.title.indexOf('title:') > -1) document.title = limpar(document.title);
    if (tudo) document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.search-results__pagination a').forEach(function (a) { if (a.href.indexOf('gt=tudo') < 0) a.href += (a.href.indexOf('?') < 0 ? '?' : '&') + 'gt=tudo'; });
    });
  } catch (e) {}
})();
</script>
<style>html.gt-busca-trocando .search-results { visibility: hidden !important; }</style>
{%- endif -%}
{%- comment -%} FIM BUSCA-TITULO {%- endcomment -%}
{%- comment -%} CSS no topo para evitar flash sem estilo (FOUC) {%- endcomment -%}
<style>/*SEARCHWRAP*/ .search-results__card-wrap[hidden] { display: none !important; } .search-results__empty { text-align: center; padding: 48px 16px; font-size: 16px; color: #666; } /*SEARCHRELEV*/ .search-results__card-wrap { display: contents; } </style>
<style>
  /* ===== Página de Resultados de Busca — vitrine ===== */

  .search-results {
    background: #ffffff;
    max-width: 1600px;
    margin: 0 auto;
    padding: 30px 50px 60px;
    box-sizing: border-box;
  }

  /* --- Header --- */
  .search-results__header {
    text-align: center;
    margin-bottom: 40px;
  }
  .search-results__title {
    font-family: 'Raleway', sans-serif;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: none;
    color: #545454;
    margin: 0 0 24px 0;
    line-height: 1.4;
  }

  /* --- Barra de busca --- */
  .search-results__form {
    max-width: 560px;
    margin: 0 auto;
  }
  .search-results__input-wrap {
    display: flex;
    border-bottom: 1px solid rgba(84, 84, 84, 0.3);
  }
  .search-results__input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #545454;
    padding: 12px 0;
    outline: none;
    letter-spacing: 0.3px;
  }
  .search-results__input::placeholder {
    color: rgba(84, 84, 84, 0.4);
  }
  .search-results__submit {
    background: none;
    border: none;
    color: #545454;
    cursor: pointer;
    padding: 12px 4px;
    transition: opacity 0.2s;
  }
  .search-results__submit:hover {
    opacity: 0.6;
  }

  /* --- Grid de produtos (vitrine) --- */
  .search-results__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px 12px;
  }

  /* --- Item de página/artigo (não-produto) --- */
  .search-results__page-item {
    display: block;
    text-decoration: none;
    padding: 20px;
    border: 1px solid rgba(84, 84, 84, 0.1);
    transition: border-color 0.2s;
  }
  .search-results__page-item:hover {
    border-color: rgba(84, 84, 84, 0.3);
  }
  .search-results__page-title {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #545454;
    margin: 0 0 8px 0;
  }
  .search-results__page-excerpt {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(84, 84, 84, 0.7);
    margin: 0;
    line-height: 1.5;
  }

  /* --- Paginação --- */
  .search-results__pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 48px;
  }
  .search-results__page-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border: 1px solid rgba(84, 84, 84, 0.2);
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    color: #545454;
    text-decoration: none;
    transition: all 0.2s;
  }
  .search-results__page-link:hover {
    border-color: #545454;
  }
  .search-results__page-link.is-current {
    background: #545454;
    color: #ffffff;
    border-color: #545454;
  }

  /* --- Sem resultados --- */
  .search-results__empty {
    text-align: center;
    padding: 40px 0;
  }
  .search-results__empty-text {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    color: #545454;
    margin: 0 0 24px 0;
    line-height: 1.6;
  }
  .search-results__suggestions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .search-results__suggestion {
    display: inline-block;
    padding: 10px 24px;
    border: 1px solid rgba(84, 84, 84, 0.25);
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #545454;
    text-decoration: none;
    transition: all 0.2s;
  }
  .search-results__suggestion:hover {
    border-color: #545454;
    background: #545454;
    color: #ffffff;
  }

  /* --- Responsivo --- */
  @media (max-width: 1024px) {
    .search-results {
      padding: 24px 20px 40px;
    }
    .search-results__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px 10px;
    }
    .search-results__title {
      font-size: 26px;
    }
  }

  @media (max-width: 768px) {
    .search-results__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px 8px;
    }
  }

  @media (max-width: 480px) {
    .search-results {
      padding: 16px 16px 40px;
    }
    .search-results__title {
      font-size: 22px;
    }
    .search-results__input {
      font-size: 14px;
    }
  }
</style>
{% comment %}
  Página de resultados de busca — layout vitrine (grid de cards)
  Usa o snippet product-card para manter visual consistente com PLP
{% endcomment %}

<div class="search-results">
  <div class="search-results__header">
    <h1 class="search-results__title">
      {% if search.performed %}
        {% if search.results_count > 0 %}
          Resultados para "{{ gt_busca_txt }}"
        {% else %}
          Nenhum resultado para "{{ gt_busca_txt }}"
        {% endif %}
      {% else %}
        Buscar
      {% endif %}
    </h1>

    {% comment %} Barra de busca persistente {% endcomment %}
    <form action="/search" method="get" class="search-results__form">
      <input type="hidden" name="type" value="product" />
      <div class="search-results__input-wrap">
        <input
          type="text"
          name="q"
          value="{{ gt_busca_txt | escape }}"
          placeholder="O que você procura?"
          class="search-results__input"
          autocomplete="off"
        />
        <button type="submit" class="search-results__submit" aria-label="Buscar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>
        </button>
      </div>
    </form>
  </div>

  {% if search.performed %}
    {% if search.results_count > 0 %}
      {% paginate search.results by 250 %}
      <div class="search-results__grid" id="search-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            <div class="search-results__card-wrap" data-release="{{ item.metafields.custom.data_lancamento | default: item.created_at | date: '%s' }}" data-created="{{ item.created_at | date: '%s' }}">
              {% render 'product-card', product: item %}
            </div>
          {% else %}
            <a href="{{ item.url }}" class="search-results__page-item">
              <h3 class="search-results__page-title">{{ item.title }}</h3>
              <p class="search-results__page-excerpt">{{ item.content | strip_html | truncatewords: 30 }}</p>
            </a>
          {% endif %}
        {% endfor %}
      </div>
      {% comment %} Busca pura do Shopify (31/10/2026, decisao da Ale): sem filtro nem ordenacao no tema. Versoes anteriores em assets/backup-main-search-*.txt {% endcomment %}

      {% if paginate.pages > 1 %}
        <nav class="search-results__pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="search-results__page-link">&laquo; Anterior</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="search-results__page-link">{{ part.title }}</a>
            {% else %}
              <span class="search-results__page-link is-current">{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="search-results__page-link">Próxima &raquo;</a>
          {% endif %}
        </nav>
      {% endif %}
      {% endpaginate %}
    {% else %}
      {% comment %} Sem resultados — sugestões {% endcomment %}
      <div class="search-results__empty">
        <p class="search-results__empty-text">Não encontramos produtos para essa busca. Tente outro termo ou navegue pelas categorias:</p>
        <div class="search-results__suggestions">
          <a href="/collections/novidades" class="search-results__suggestion">Novidades</a>
          <a href="/collections/roupas" class="search-results__suggestion">Roupas</a>
          <a href="/collections/sale-ver26" class="search-results__suggestion">Sale</a>
        </div>
      </div>
    {% endif %}
  {% endif %}
</div>



{% schema %}
{
  "name": "Busca",
  "settings": []
}
{% endschema %}
