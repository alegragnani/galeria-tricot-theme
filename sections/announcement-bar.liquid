{%- comment -%} RELOGIO-TOPO-GT v2 (25/11/2026, Ale): liga enquanto o prazo (relogio_fim) nao acabou {%- endcomment -%}
{%- assign gtr_fim_s = section.settings.relogio_fim | date: '%s' | plus: 0 -%}
{%- assign gtr_now_s = 'now' | date: '%s' | plus: 0 -%}
{%- assign gtr_on = false -%}
{%- if gtr_fim_s > gtr_now_s -%}{%- assign gtr_on = true -%}{%- endif -%}
{%- comment -%} CSS no topo para evitar flash sem estilo (FOUC) {%- endcomment -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap');

  .announcement-bar {
    background-color: #4A3222;
    color: #FAF6F1;
    padding: 7px 0;
    font-size: 11px;
    text-align: center;
    letter-spacing: 0.8px;
    position: relative;
    z-index: 101;
    font-family: 'Raleway', -apple-system, sans-serif;
    min-height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .announcement-bar__wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: 100%;
    padding: 0 20px;
  }

  .announcement-bar__button {
    background: none;
    border: none;
    color: #FAF6F1;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
  }

  .announcement-bar__button:hover {
    opacity: 0.8;
  }

  .announcement-bar__content {
    flex: 1;
    min-width: 0;
    min-height: 17px;
  }

  .announcement-bar__messages {
    position: relative;
    height: 17px;
  }

  .announcement-bar__message {
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
    position: absolute;
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .announcement-bar__message.is-active {
    opacity: 1;
    position: relative;
  }

  .announcement-bar__message p {
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    font-size: 11px;
    line-height: 16px;
  }

  @media (max-width: 640px) {
    .announcement-bar__wrapper {
      gap: 12px;
      padding: 0 12px;
    }

    .announcement-bar__button {
      flex-shrink: 0;
    }

    .announcement-bar__message p {
      font-size: 12px;
    }
  }
  /* TARJA-GT: texto em caixa normal; setas so quando ha mais de uma mensagem */
  .announcement-bar__message, .announcement-bar__message p { text-transform: none !important; letter-spacing: 0.5px; font-size: 14px !important; }
  {% if section.blocks.size <= 1 %}.announcement-bar__button { display: none !important; }{% endif %}
  /* RELOGIO-TOPO-GT v2 (25/11/2026, Ale): ate o fim do prazo a tarja fica mais alta, em marrom avermelhado, com relogio de um lado e texto da promocao do outro; depois a mensagem normal volta sozinha */
  .announcement-bar--relogio { background-color: var(--gt-rt-cor, #603024); padding: 11px 16px; height: auto; overflow: visible; }
  .announcement-bar--relogio .announcement-bar__wrapper { display: none !important; }
  .gt-rt { display: flex; align-items: center; justify-content: center; gap: 30px; color: #FAF6F1; font-family: 'Raleway', -apple-system, sans-serif; }
  .gt-rt__tempo { display: inline-flex; align-items: flex-start; gap: 9px; }
  .gt-rt__u { display: inline-flex; flex-direction: column; align-items: center; min-width: 36px; }
  .gt-rt__u b { font-size: 23px; font-weight: 600; line-height: 1; letter-spacing: 0.5px; font-variant-numeric: tabular-nums lining-nums; }
  .gt-rt__u i { font-style: normal; font-size: 11px; letter-spacing: 0.4px; margin-top: 5px; opacity: 0.9; }
  .gt-rt__sep { font-size: 20px; font-weight: 600; line-height: 1.05; }
  .gt-rt__div { width: 1px; align-self: stretch; min-height: 46px; background: rgba(250, 246, 241, 0.5); }
  .gt-rt__txt { display: flex; flex-direction: column; align-items: flex-start; text-align: left; color: #FAF6F1; text-decoration: none; letter-spacing: 0.4px; min-width: 0; gap: 2px; }
  .gt-rt__l1 { font-size: 13px; font-weight: 700; letter-spacing: 2.2px; line-height: 1.25; text-transform: uppercase; }
  .gt-rt__l2 { font-size: 14px; font-weight: 500; line-height: 1.3; font-variant-numeric: lining-nums; }
  .gt-rt__l3 { font-size: 12px; font-weight: 400; line-height: 1.3; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) {
    .announcement-bar--relogio { padding: 9px 8px; }
    .gt-rt { gap: 11px; }
    .gt-rt__tempo { gap: 4px; }
    .gt-rt__u { min-width: 27px; }
    .gt-rt__u b { font-size: 18px; }
    .gt-rt__u i { font-size: 9px; margin-top: 4px; }
    .gt-rt__sep { font-size: 15px; }
    .gt-rt__div { min-height: 42px; }
    .gt-rt__txt { gap: 1px; } .gt-rt__l1 { font-size: 11.5px; letter-spacing: 1.6px; }
    .gt-rt__l2 { font-size: 12px; }
    .gt-rt__l3 { font-size: 11px; }
  }
  {% if gtr_on %}
  /* antes do script do menu rodar, o menu ja nasce abaixo da faixa alta (depois o script ajusta sozinho) */
  html body .site-header:not(.gt-rt-x) { top: 76px; }
  @media (max-width: 640px) { html body .site-header:not(.gt-rt-x) { top: 64px; } }
  {% endif %}
</style>
<div class="announcement-bar{% if gtr_on %} announcement-bar--relogio{% endif %}" data-announcement-bar{% if gtr_on %} style="--gt-rt-cor: {{ section.settings.relogio_cor }};"{% endif %}>
  {%- if gtr_on -%}
  <div class="gt-rt" data-gt-relogio-topo data-fim="{{ section.settings.relogio_fim | escape }}">
    <span class="gt-rt__tempo" aria-hidden="true"><span class="gt-rt__u" data-ud><b data-d>00</b><i>dias</i></span><span class="gt-rt__sep" data-sd>:</span><span class="gt-rt__u"><b data-h>00</b><i>horas</i></span><span class="gt-rt__sep">:</span><span class="gt-rt__u"><b data-m>00</b><i>min</i></span><span class="gt-rt__sep">:</span><span class="gt-rt__u"><b data-s>00</b><i>seg</i></span></span>
    <span class="gt-rt__div"></span>
    <a class="gt-rt__txt" href="{{ section.settings.relogio_link | default: '/collections/black-november' }}"><span class="gt-rt__l1">{{ section.settings.relogio_titulo | escape }}</span><span class="gt-rt__l2">{{ section.settings.relogio_linha2 | escape }}</span><span class="gt-rt__l3">{{ section.settings.relogio_linha3 | escape }}</span></a>
  </div>
  {%- endif -%}
  <div class="announcement-bar__wrapper">
    <button
      class="announcement-bar__button announcement-bar__button--prev"
      aria-label="Previous announcement"
      data-announcement-prev
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        width="20"
        height="20"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="announcement-bar__content">
      <div class="announcement-bar__messages" data-announcement-messages>
        {% for block in section.blocks %}
          <div
            class="announcement-bar__message {% if forloop.first %}is-active{% endif %}"
            data-announcement-message
            {{ block.shopify_attributes }}
          >
            <p>{{ block.settings.message }}</p>
          </div>
        {% endfor %}
      </div>
    </div>

    <button
      class="announcement-bar__button announcement-bar__button--next"
      aria-label="Next announcement"
      data-announcement-next
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        width="20"
        height="20"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</div>



<script>
  document.addEventListener('DOMContentLoaded', function() {
    const bar = document.querySelector('[data-announcement-bar]');
    if (!bar) return;

    const messages = Array.from(bar.querySelectorAll('[data-announcement-message]'));
    const prevBtn = bar.querySelector('[data-announcement-prev]');
    const nextBtn = bar.querySelector('[data-announcement-next]');
    let currentIndex = 0;

    if (messages.length <= 1) {
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
      return;
    }

    function showMessage(index) {
      messages.forEach((msg) => msg.classList.remove('is-active'));
      messages[index].classList.add('is-active');
      currentIndex = index;
    }

    prevBtn?.addEventListener('click', () => {
      const newIndex = currentIndex === 0 ? messages.length - 1 : currentIndex - 1;
      showMessage(newIndex);
    });

    nextBtn?.addEventListener('click', () => {
      const newIndex = currentIndex === messages.length - 1 ? 0 : currentIndex + 1;
      showMessage(newIndex);
    });

    // Auto-rotate every 5 seconds
    setInterval(() => {
      const newIndex = currentIndex === messages.length - 1 ? 0 : currentIndex + 1;
      showMessage(newIndex);
    }, 5000);
  });
</script>

{%- if gtr_on -%}
<script>
  /* RELOGIO-TOPO-GT: conta ate o fim do prazo; quando acaba, tira o relogio e a mensagem normal da tarja volta */
  (function () {
    var el = document.querySelector('[data-gt-relogio-topo]');
    if (!el) return;
    var bar = el.closest('.announcement-bar');
    var fim = new Date(el.getAttribute('data-fim')).getTime();
    var timer = null;
    function acabou() { if (timer) clearInterval(timer); if (bar) { bar.classList.remove('announcement-bar--relogio'); bar.style.removeProperty('--gt-rt-cor'); } if (el.parentNode) el.parentNode.removeChild(el); }
    function p(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      var s = Math.floor((fim - Date.now()) / 1000);
      if (isNaN(fim) || s <= 0) { acabou(); return; }
      var d = Math.floor(s / 86400);
      el.querySelector('[data-d]').textContent = p(d);
      el.querySelector('[data-h]').textContent = p(Math.floor((s % 86400) / 3600));
      el.querySelector('[data-m]').textContent = p(Math.floor((s % 3600) / 60));
      el.querySelector('[data-s]').textContent = p(s % 60);
      el.querySelector('[data-ud]').style.display = d === 0 ? 'none' : '';
      el.querySelector('[data-sd]').style.display = d === 0 ? 'none' : '';
    }
    tick();
    timer = setInterval(tick, 1000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "text", "id": "relogio_fim", "label": "Relógio: fim (ano-mês-diaThora). Vazio = sem relógio", "default": "2026-11-29T23:59:59-03:00" },
    { "type": "color", "id": "relogio_cor", "label": "Relógio: cor da faixa", "default": "#603024" },
    { "type": "text", "id": "relogio_titulo", "label": "Relógio: título", "default": "BLACK FRIDAY" },
    { "type": "text", "id": "relogio_linha2", "label": "Relógio: segunda linha", "default": "Até 80% OFF + 15% extra" },
    { "type": "text", "id": "relogio_linha3", "label": "Relógio: terceira linha (sublinhada)", "default": "na aba Black Friday" },
    { "type": "text", "id": "relogio_link", "label": "Relógio: link ao clicar no texto", "default": "/collections/black-november" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "message",
          "label": "Announcement Message",
          "default": "FRETE GRÁTIS ACIMA DE R$ 499"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "message": "FRETE GRÁTIS ACIMA DE R$ 499"
          }
        },
        {
          "type": "message",
          "settings": {
            "message": "PARCELE EM ATÉ 6X SEM JUROS"
          }
        },
        {
          "type": "message",
          "settings": {
            "message": "TROCA FÁCIL EM ATÉ 30 DIAS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
