<!-- Footer — BP style -->
<footer class="site-footer">
  <!-- Newsletter: titulo esquerda + input direita (BP layout) -->
  <div class="site-footer__newsletter">
    <div class="site-footer__newsletter-inner">
      <div class="site-footer__newsletter-left">
        {% if section.settings.show_newsletter %}
          <h2 class="site-footer__newsletter-title">{{ section.settings.newsletter_heading }}</h2>
          <p class="site-footer__newsletter-desc">{{ section.settings.newsletter_text }}</p>
        {% endif %}
      </div>
      <div class="site-footer__newsletter-right">
        {% if section.settings.show_newsletter %}
          {% form 'customer', class: 'site-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="site-footer__input-wrapper">
              <input type="email" name="contact[email]" placeholder="E-mail" required class="site-footer__input">
              <button type="submit" class="site-footer__submit" aria-label="Inscrever">
                <svg viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M1 5h12M9 1l4 4-4 4"/></svg>
              </button>
            </div>
          {% endform %}
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Colunas: menus + logo/social (BP layout) -->
  <div class="site-footer__main">
    <div class="site-footer__columns">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'link_list' %}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
              {% if block.settings.menu != blank %}
                <ul class="site-footer__links">
                  {% for link in linklists[block.settings.menu].links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% when 'text' %}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
              <div class="site-footer__text">{{ block.settings.text }}</div>
            </div>
        {% endcase %}
      {% endfor %}

      <!-- 4a coluna: logo + social (BP style) -->
      <div class="site-footer__col site-footer__col--brand">
        {% if section.settings.logo %}
          <a href="/" class="site-footer__logo-link">
            <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" class="site-footer__logo">
          </a>
        {% else %}
          <a href="/" class="site-footer__logo-text">{{ shop.name }}</a>
        {% endif %}

        <div class="site-footer__social">
          {% if section.settings.social_instagram != blank %}
            <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="site-footer__social-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
            </a>
          {% endif %}
          {% if section.settings.social_whatsapp != blank %}
            <a href="{{ section.settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp" class="site-footer__social-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.social_youtube != blank %}
            <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube" class="site-footer__social-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="4"/><polygon points="10,8 16,12 10,16" fill="currentColor" stroke="none"/></svg>
            </a>
          {% endif %}
          {% if section.settings.social_tiktok != blank %}
            <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok" class="site-footer__social-link">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V9.42a8.16 8.16 0 004.76 1.52V7.49a4.85 4.85 0 01-1-.8z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.social_pinterest != blank %}
            <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest" class="site-footer__social-link">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.social_linkedin != blank %}
            <a href="{{ section.settings.social_linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" class="site-footer__social-link">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom: pagamento + copyright (BP style) -->
  <div class="site-footer__bottom">
    {% if section.settings.show_payment_icons %}
      <div class="site-footer__payments">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}
        {% endfor %}
      </div>
    {% endif %}
    <p class="site-footer__copyright">© {{ 'now' | date: '%Y' }}, {{ shop.name }}. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #F9F7F0;
    color: #545454;
    font-family: 'Raleway', sans-serif;
    margin-top: 0;
  }

  /* ============ NEWSLETTER (BP: titulo+desc esquerda, input direita) ============ */
  .site-footer__newsletter {
    padding: 48px 0 40px;
    max-width: 1600px;
    margin: 0 auto;
    padding-left: 50px;
    padding-right: 50px;
  }

  .site-footer__newsletter-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 60px;
  }

  .site-footer__newsletter-left {
    flex: 0 0 auto;
    max-width: 500px;
  }

  .site-footer__newsletter-title {
    font-family: 'Italiana', 'Cormorant Garamond', Georgia, serif;
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #9E885E;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .site-footer__newsletter-desc {
    font-size: 14px;
    font-weight: 400;
    color: rgba(84, 84, 84, 0.75);
    line-height: 1.6;
    margin: 0;
  }

  .site-footer__newsletter-right {
    flex: 1;
    max-width: 600px;
  }

  .site-footer__form {
    width: 100%;
  }

  .site-footer__input-wrapper {
    display: flex;
    align-items: center;
    border-bottom: 0.67px solid #9E885E;
    padding-bottom: 4px;
  }

  .site-footer__input {
    flex: 1;
    padding: 8px 0;
    background: transparent;
    border: none;
    color: #545454;
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    letter-spacing: 0.3px;
    outline: none;
  }

  .site-footer__input::placeholder {
    color: rgba(84, 84, 84, 0.4);
  }

  .site-footer__submit {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #9E885E;
    transition: opacity 0.2s ease;
  }

  .site-footer__submit:hover {
    opacity: 0.6;
  }

  .site-footer__submit svg {
    width: 18px;
    height: 14px;
  }

  /* ============ COLUNAS (BP: 3 menus + logo/social) ============ */
  .site-footer__main {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 50px 40px;
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.2fr;
    gap: 40px;
  }

  .site-footer__heading {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #545454;
    margin: 0 0 20px 0;
  }

  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer__links li {
    line-height: 2;
  }

  .site-footer__links a {
    color: rgba(84, 84, 84, 0.75);
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.6px;
    transition: color 0.2s ease;
  }

  .site-footer__links a:hover {
    color: #9E885E;
  }

  .site-footer__text {
    font-size: 14px;
    line-height: 2;
    color: rgba(84, 84, 84, 0.75);
  }

  /* 4a coluna: logo + social */
  .site-footer__col--brand {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 24px;
  }

  .site-footer__logo-link {
    display: block;
  }

  .site-footer__logo {
    max-width: 200px;
    height: auto;
    opacity: 0.7;
  }

  .site-footer__logo-text {
    font-family: 'Italiana', 'Cormorant Garamond', Georgia, serif;
    font-size: 36px;
    font-weight: 400;
    color: #9E885E;
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .site-footer__social {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .site-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: #545454;
    transition: color 0.2s ease;
  }

  .site-footer__social-link:hover {
    color: #9E885E;
  }

  .site-footer__social-link svg {
    width: 22px;
    height: 22px;
  }

  /* ============ BOTTOM: pagamento + copyright ============ */
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 24px 50px 30px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .site-footer__payments {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .site-footer__payment-icon {
    height: 24px;
    opacity: 0.7;
  }

  .site-footer__copyright {
    font-size: 12px;
    letter-spacing: 0.3px;
    color: rgba(84, 84, 84, 0.6);
    margin: 0;
    text-align: center;
  }

  /* ============ TABLET ============ */
  @media (max-width: 1024px) {
    .site-footer__newsletter {
      padding-left: 32px;
      padding-right: 32px;
    }

    .site-footer__main {
      padding: 0 32px 40px;
    }

    .site-footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .site-footer__col--brand {
      align-items: flex-start;
    }
  }

  /* ============ MOBILE ============ */
  @media (max-width: 749px) {
    .site-footer__newsletter {
      padding: 32px 16px 28px;
    }

    .site-footer__newsletter-inner {
      flex-direction: column;
      gap: 20px;
    }

    .site-footer__newsletter-right {
      max-width: 100%;
    }

    .site-footer__newsletter-title {
      font-size: 26px;
    }

    .site-footer__main {
      padding: 0 16px 32px;
    }

    .site-footer__columns {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .site-footer__col--brand {
      align-items: center;
    }

    .site-footer__social {
      justify-content: center;
    }

    .site-footer__bottom {
      padding: 20px 16px 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Mostrar newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Título newsletter",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Texto newsletter",
      "default": "Inscreva-se para receber conteúdo exclusivo, atualizações em primeira mão e ofertas especiais."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo do footer",
      "info": "Aparece na 4ª coluna. Se vazio, mostra o nome da loja."
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_whatsapp",
      "label": "WhatsApp"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "LinkedIn"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Mostrar ícones de pagamento",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Institucional" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Atendimento" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Seg a Sex, 9h às 18h<br>WhatsApp: (11) 99999-9999<br>contato@galeriatricot.com.br</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
