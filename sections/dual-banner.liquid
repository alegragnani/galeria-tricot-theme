<!-- Dual Banner Section - Banner duplo lado a lado (estilo PatBO) -->
<section class="dual-banner">
  <div class="dual-banner__container">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="dual-banner__item" {{ block.shopify_attributes }}>
        <div class="dual-banner__image-wrapper">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1800 }} 1800w"
              sizes="(max-width: 768px) 100vw, 50vw"
              alt="{{ block.settings.heading | escape }}"
              class="dual-banner__image"
              loading="lazy"
              width="1200"
              height="900"
            >
          {% else %}
            <div class="dual-banner__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          {% endif %}
          <div class="dual-banner__overlay">
            <div class="dual-banner__content">
              {% if block.settings.subheading != blank %}
                <p class="dual-banner__subheading">{{ block.settings.subheading }}</p>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h3 class="dual-banner__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.cta_text != blank %}
                <span class="dual-banner__cta">{{ block.settings.cta_text }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

<style>
  .dual-banner {
    padding: 40px 0 0;
    margin: 0;
    background-color: #ffffff;
  }

  .dual-banner__container {
    width: 100vw;
    max-width: 100vw;
    margin: 0;
    margin-left: calc(50% - 50vw);
    padding: 0;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .dual-banner__item {
    display: block;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .dual-banner__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .dual-banner__image,
  .dual-banner__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .dual-banner__item:hover .dual-banner__image {
    transform: scale(1.04);
  }

  .dual-banner__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 40px 24px;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.35) 100%);
  }

  .dual-banner__content {
    text-align: center;
    color: #ffffff;
  }

  .dual-banner__subheading {
    font-family: 'Raleway', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin: 0 0 8px;
  }

  .dual-banner__heading {
    font-family: 'Raleway', -apple-system, sans-serif;
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .dual-banner__cta {
    display: inline-block;
    font-family: 'Raleway', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #ffffff;
    padding: 12px 28px;
    border: 1px solid #ffffff;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .dual-banner__item:hover .dual-banner__cta {
    background-color: #ffffff;
    color: #545454;
  }

  @media (max-width: 768px) {
    .dual-banner {
      padding: 20px 0 0;
    }
    .dual-banner__container {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .dual-banner__heading {
      font-size: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Banner Duplo",
  "tag": "section",
  "class": "section-dual-banner",
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem (proporção 4:3 recomendada)"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Texto pequeno (cima)",
          "default": "Confira"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título principal",
          "default": "Nova Coleção"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Texto do botão",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Banner Duplo",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}