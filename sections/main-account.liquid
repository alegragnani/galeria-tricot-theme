{% comment %}
  Customer account section - main-account.liquid
{% endcomment %}

<div class="account-page">
  <div class="account-header">
    <h1 class="account-title">MEU PERFIL</h1>
    <a href="/account/logout" class="logout-link">SAIR</a>
  </div>

  <div class="account-container">
    {% comment %} Account Navigation {% endcomment %}
    <nav class="account-nav">
      <a href="#account-info" class="nav-link active">Meus Dados</a>
      <a href="#addresses" class="nav-link">Endereços</a>
      <a href="#orders" class="nav-link">Pedidos</a>
      <a href="#wishlist" class="nav-link">Favoritos</a>
    </nav>

    {% comment %} Account Info Section {% endcomment %}
    <section id="account-info" class="account-section active">
      <h2>Meus Dados</h2>

      <div class="account-info">
        <div class="info-group">
          <label>Nome:</label>
          <p>{{ customer.first_name }} {{ customer.last_name }}</p>
        </div>

        <div class="info-group">
          <label>E-mail:</label>
          <p>{{ customer.email }}</p>
        </div>

        <div class="info-group">
          <label>CPF:</label>
          <p>{% if customer.metafields.custom.cpf %}{{ customer.metafields.custom.cpf }}{% else %}Não informado{% endif %}</p>
        </div>

        <button class="btn btn--secondary" id="edit-profile-btn">EDITAR PERFIL</button>
      </div>

      {% comment %} Edit Profile Form {% endcomment %}
      <form id="edit-profile-form" class="edit-form" style="display: none;">
        <div class="form-group">
          <label for="first-name">Nome *</label>
          <input type="text" id="first-name" name="customer[first_name]" value="{{ customer.first_name }}" required />
        </div>

        <div class="form-group">
          <label for="last-name">Sobrenome *</label>
          <input type="text" id="last-name" name="customer[last_name]" value="{{ customer.last_name }}" required />
        </div>

        <div class="form-group">
          <label for="email">E-mail *</label>
          <input type="email" id="email" name="customer[email]" value="{{ customer.email }}" required />
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary">SALVAR</button>
          <button type="button" class="btn btn--secondary" id="cancel-edit">CANCELAR</button>
        </div>
      </form>
    </section>

    {% comment %} Addresses Section {% endcomment %}
    <section id="addresses" class="account-section">
      <h2>Meus Endereços</h2>

      {% if customer.addresses.size > 0 %}
        <div class="addresses-grid">
          {% for address in customer.addresses %}
            <div class="address-card">
              <p>
                {{ address.street }}, {{ address.number }}
                {% if address.apartment %}Apt. {{ address.apartment }}{% endif %}<br>
                {{ address.city }}, {{ address.province }} {{ address.zip }}
              </p>
              <a href="/account/addresses/{{ address.id }}" class="link-text">Editar</a>
              <a href="#" class="link-text" onclick="deleteAddress({{ address.id }})">Excluir</a>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <button class="btn btn--secondary" id="add-address-btn">ADICIONAR NOVO ENDEREÇO</button>
    </section>

    {% comment %} Orders Section {% endcomment %}
    <section id="orders" class="account-section">
      <h2>Meus Pedidos</h2>

      {% if customer.orders.size > 0 %}
        <table class="orders-table">
          <thead>
            <tr>
              <th>Número do Pedido</th>
              <th>Data</th>
              <th>Status</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for order in customer.orders %}
              <tr>
                <td>#{{ order.order_number }}</td>
                <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                <td>
                  <span class="order-status status-{{ order.fulfillment_status | downcase }}">
                    {{ order.fulfillment_status | capitalize }}
                  </span>
                </td>
                <td>{{ order.total_price | money_with_currency }}</td>
                <td>
                  <a href="{{ order.customer_url }}" class="link-text">Ver Detalhes</a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p>Você ainda não fez nenhum pedido.</p>
        <a href="/collections/all" class="btn btn--primary">COMEÇAR A COMPRAR</a>
      {% endif %}
    </section>

    {% comment %} Wishlist Section {% endcomment %}
    <section id="wishlist" class="account-section">
      <h2>Meus Favoritos</h2>

      {% if customer.metafields.custom.wishlist %}
        <div class="wishlist-grid">
          {% assign wishlist = customer.metafields.custom.wishlist | split: ',' %}
          {% for product_id in wishlist %}
            {% assign product = all_products[product_id] %}
            {% if product %}
              {% render 'product-card', product: product %}
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <p>Você ainda não tem itens nos favoritos.</p>
        <a href="/collections/all" class="btn btn--primary">EXPLORAR COLEÇÕES</a>
      {% endif %}
    </section>
  </div>
</div>

<style>
  .account-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .account-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 50px;
    flex-wrap: wrap;
    gap: 20px;
  }

  .account-title {
    font-family: 'Noto Serif', serif;
    font-size: 42px;
    font-weight: 400;
    letter-spacing: 2px;
    margin: 0;
    text-transform: uppercase;
  }

  .logout-link {
    font-size: 12px;
    color: #000;
    text-decoration: underline;
    cursor: pointer;
  }

  .account-container {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
  }

  .account-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nav-link {
    padding: 15px;
    border-bottom: 1px solid #e0e0e0;
    color: #666;
    text-decoration: none;
    font-size: 13px;
    transition: all 0.3s ease;
  }

  .nav-link.active {
    background: #f5f5f5;
    color: #000;
    font-weight: 600;
  }

  .nav-link:hover {
    color: #000;
  }

  .account-section {
    display: none;
  }

  .account-section.active {
    display: block;
  }

  .account-section h2 {
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 25px 0;
  }

  .account-info {
    background: #f9f9f9;
    padding: 25px;
    margin-bottom: 25px;
  }

  .info-group {
    margin-bottom: 15px;
  }

  .info-group label {
    font-size: 12px;
    font-weight: 600;
    color: #666;
    display: block;
    margin-bottom: 5px;
  }

  .info-group p {
    font-size: 14px;
    margin: 0;
  }

  .edit-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    background: #f9f9f9;
    padding: 25px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .form-group input {
    padding: 10px;
    border: 1px solid #e0e0e0;
    font-size: 14px;
  }

  .form-actions {
    display: flex;
    gap: 10px;
  }

  .btn--primary,
  .btn--secondary {
    padding: 10px 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn--primary {
    background: #000;
    color: #fff;
  }

  .btn--primary:hover {
    background: #333;
  }

  .btn--secondary {
    background: transparent;
    border: 1px solid #000;
    color: #000;
  }

  .btn--secondary:hover {
    background: #000;
    color: #fff;
  }

  .addresses-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 25px;
  }

  .address-card {
    background: #f9f9f9;
    padding: 20px;
    border: 1px solid #e0e0e0;
  }

  .address-card p {
    font-size: 14px;
    margin: 0 0 15px 0;
    line-height: 1.6;
  }

  .link-text {
    font-size: 12px;
    color: #000;
    text-decoration: underline;
    margin-right: 15px;
    cursor: pointer;
  }

  .orders-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 25px;
  }

  .orders-table th {
    text-align: left;
    padding: 15px;
    border-bottom: 1px solid #e0e0e0;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
  }

  .orders-table td {
    padding: 15px;
    border-bottom: 1px solid #e0e0e0;
    font-size: 14px;
  }

  .order-status {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: 600;
  }

  .status-fulfilled {
    background: #d4edda;
    color: #155724;
  }

  .status-partial {
    background: #fff3cd;
    color: #856404;
  }

  .status-pending {
    background: #d1ecf1;
    color: #0c5460;
  }

  .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  @media (max-width: 1024px) {
    .account-container {
      grid-template-columns: 1fr;
    }

    .account-nav {
      flex-direction: row;
      border-bottom: 1px solid #e0e0e0;
    }

    .nav-link {
      flex: 1;
      border-right: 1px solid #e0e0e0;
      border-bottom: none;
    }

    .addresses-grid {
      grid-template-columns: 1fr;
    }

    .wishlist-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .account-page {
      padding: 30px 20px;
    }

    .account-title {
      font-size: 28px;
    }

    .wishlist-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const navLinks = document.querySelectorAll('.nav-link');
    const sections = document.querySelectorAll('.account-section');
    const editBtn = document.getElementById('edit-profile-btn');
    const editForm = document.getElementById('edit-profile-form');
    const cancelBtn = document.getElementById('cancel-edit');

    navLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const target = this.getAttribute('href');

        navLinks.forEach(l => l.classList.remove('active'));
        sections.forEach(s => s.classList.remove('active'));

        this.classList.add('active');
        document.querySelector(target).classList.add('active');
      });
    });

    editBtn?.addEventListener('click', function() {
      editForm.style.display = 'flex';
    });

    cancelBtn?.addEventListener('click', function() {
      editForm.style.display = 'none';
    });
  });
</script>

{% schema %}
{
  "name": "Account"
}
{% endschema %}
