  .conjunto__item-check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin-top: 4px;
    accent-color: #B3883D;
    cursor: pointer;
  }
  .conjunto__item-img {
    flex-shrink: 0;
    width: 100px;
    height: 130px;
    object-fit: cover;
  }
  .conjunto__item-info { flex: 1; min-width: 0; }
  .conjunto__item-name {
    font-family: 'Raleway', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #545454;
    margin-bottom: 6px;
  }
  .conjunto__item-name a { color: inherit; text-decoration: none; }
  .conjunto__item-name a:hover { text-decoration: underline; }
  .conjunto__item-price {
    font-family: 'Raleway', sans-serif;
    font-size: 15px;
    color: #545454;
    margin-bottom: 4px;
  }
  .conjunto__item-installments {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    color: #B3883D;
    margin-bottom: 10px;
  }
  .conjunto__item-sizes-label {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #545454;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .conjunto__item-sizes { display: flex; gap: 6px; flex-wrap: wrap; }
  .conjunto__size-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid rgba(84,84,84,0.25);
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    color: #545454;
    cursor: pointer;
    transition: all 0.15s;
    background: transparent;
  }
  .conjunto__size-pill:hover:not(.is-soldout) { border-color: #545454; }
  .conjunto__size-pill.is-selected {
    background: #545454;
    color: #fff;
    border-color: #545454;
  }
  .conjunto__size-pill.is-soldout {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
  }
  .conjunto__add-btn {
    width: 100%;
    padding: 16px 0;
    margin-top: 20px;
    background: #B3883D;
    color: #fff;
    border: none;
    font-family: 'Raleway', sans-serif;
