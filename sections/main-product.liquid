{% comment %}
  Product page (PDP) – estilo BP
  Layout: galeria à esquerda (scroll vertical de imagens grandes) + info à direita (sticky)
  Medidas conferidas na BP via getComputedStyle em 22/abr/2026
{% endcomment %}

<div class="pdp">
  {% comment %} Breadcrumb {% endcomment %}
  <nav class="pdp__breadcrumb" aria-label="breadcrumb">
    <a href="/">Início</a>
    <span class="pdp__breadcrumb-sep">›</span>
    {% if collection %}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span class="pdp__breadcrumb-sep">›</span>
    {% endif %}
    <span>{{ product.title }}</span>
  </nav>

  <div class="pdp__container">
    {% comment %} ===== GALERIA (esquerda, 50%) — carrossel horizontal como BP ===== {% endcomment %}
    <div class="pdp__gallery">
      <div class="pdp__gallery-track" id="gallery-track">
        {% for image in product.images %}
          <div class="pdp__gallery-item" data-index="{{ forloop.index0 }}">
            <img
              src="{{ image | image_url: width: 1200 }}"
              alt="{{ image.alt | default: product.title }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              class="pdp__gallery-img"
            />
          </div>
        {% endfor %}
      </div>

      {% if product.images.size > 1 %}
        {% comment %} Setas de navegação {% endcomment %}
        <button class="pdp__gallery-arrow pdp__gallery-arrow--prev" id="gallery-prev" aria-label="Imagem anterior">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 4L7 10L13 16"/></svg>
        </button>
        <button class="pdp__gallery-arrow pdp__gallery-arrow--next" id="gallery-next" aria-label="Próxima imagem">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 4L13 10L7 16"/></svg>
        </button>

        {% comment %} Dots {% endcomment %}
        <div class="pdp__gallery-dots" id="gallery-dots">
          {% for image in product.images %}
            <button class="pdp__gallery-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Imagem {{ forloop.index }}"></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% comment %} ===== INFO DO PRODUTO (direita, 50%, sticky) ===== {% endcomment %}
    <div class="pdp__info-wrapper">
      <div class="pdp__info">

        {% comment %} Vendor {% endcomment %}
        {% if product.vendor %}
          <div class="pdp__vendor">{{ product.vendor }}</div>
        {% endif %}

        {% comment %} Título {% endcomment %}
        <h1 class="pdp__title">{{ product.title }}</h1>

        {% comment %} Preço {% endcomment %}
        <div class="pdp__price">
          {% assign variant = product.selected_or_first_available_variant %}
          {% if variant.compare_at_price > variant.price %}
            <span class="pdp__price-original">{{ variant.compare_at_price | money }}</span>
          {% endif %}
          <span class="pdp__price-current {% if variant.compare_at_price > variant.price %}pdp__price-current--sale{% endif %}">
            {{ variant.price | money }}
          </span>
        </div>

        {% comment %} Parcelamento {% endcomment %}
        {% assign installment_value = variant.price | divided_by: 6 %}
        <div class="pdp__installments">
          ou 6x de {{ installment_value | money }} sem juros
        </div>

        {% comment %} Formulário de variantes {% endcomment %}
        <form class="pdp__form" id="product-form" action="/cart/add" method="post">
          <input type="hidden" name="id" id="variant-id" value="{{ variant.id }}" />

          {% for option in product.options_with_values %}
            {% assign option_name_down = option.name | downcase %}

            {% if option_name_down == 'cor' or option_name_down == 'color' %}
              {% comment %} Cor – swatches com imagem da variante {% endcomment %}
              <fieldset class="pdp__option">
                <legend class="pdp__option-label">{{ option.name }}: <span class="pdp__option-value" data-option-index="{{ forloop.index0 }}">{{ option.selected_value | default: option.values.first }}</span></legend>
                <div class="pdp__color-swatches">
                  {% for value in option.values %}
                    {% comment %} Encontrar a primeira variante com essa cor para pegar a imagem {% endcomment %}
                    {% assign swatch_image = nil %}
                    {% for v in product.variants %}
                      {% if v.options[forloop.parentloop.parentloop.index0] == value and v.featured_image %}
                        {% assign swatch_image = v.featured_image %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    <label class="pdp__color-swatch" title="{{ value }}">
                      <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" {% if forloop.first %}checked{% endif %} />
                      {% if swatch_image %}
                        <img src="{{ swatch_image | image_url: width: 120 }}" alt="{{ value }}" class="pdp__color-swatch-img" />
                      {% else %}
                        <span class="pdp__color-swatch-fallback" style="background-color: {{ value | downcase | replace: ' ', '' }};"></span>
                      {% endif %}
                    </label>
                  {% endfor %}
                </div>
              </fieldset>

            {% elsif option_name_down == 'tamanho' or option_name_down == 'size' %}
              {% comment %} Tamanho – pills {% endcomment %}
              <fieldset class="pdp__option">
                <legend class="pdp__option-label">{{ option.name }}</legend>
                <div class="pdp__sizes">
                  {% for value in option.values %}
                    <label class="pdp__size-pill">
                      <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" {% if forloop.first %}checked{% endif %} />
                      <span class="pdp__size-label">{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>

            {% else %}
              {% comment %} Outras opções – select {% endcomment %}
              <fieldset class="pdp__option">
                <legend class="pdp__option-label">{{ option.name }}</legend>
                <select name="options[{{ option.name }}]" class="pdp__select">
                  {% for value in option.values %}
                    <option value="{{ value }}" {% if forloop.first %}selected{% endif %}>{{ value }}</option>
                  {% endfor %}
                </select>
              </fieldset>
            {% endif %}
          {% endfor %}

          {% comment %} Botão comprar {% endcomment %}
          <button type="submit" class="pdp__add-to-cart" id="add-to-cart-btn"
            {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}
              ADICIONAR À SACOLA
            {% else %}
              ESGOTADO
            {% endif %}
          </button>
        </form>

        {% comment %} Links auxiliares {% endcomment %}
        <div class="pdp__aux-links">
          <a href="#" class="pdp__aux-link">Tabela de Medidas</a>
        </div>

        {% comment %} Acordeões {% endcomment %}
        <div class="pdp__accordions">
          <details class="pdp__accordion">
            <summary class="pdp__accordion-trigger">Sobre a peça</summary>
            <div class="pdp__accordion-body">
              {{ product.description }}
            </div>
          </details>

          <details class="pdp__accordion">
            <summary class="pdp__accordion-trigger">Composição</summary>
            <div class="pdp__accordion-body">
              {% if product.metafields.custom.composition %}
                {{ product.metafields.custom.composition }}
              {% else %}
                Consulte a descrição do produto.
              {% endif %}
            </div>
          </details>

          <details class="pdp__accordion">
            <summary class="pdp__accordion-trigger">Envio e Trocas</summary>
            <div class="pdp__accordion-body">
              <p>Frete grátis para compras acima de R$ 499. Trocas em até 30 dias.</p>
            </div>
          </details>
        </div>

        {% comment %} WhatsApp Personal Shopper — estilo BP {% endcomment %}
        <div class="pdp__personal-shopper">
          <h2 class="pdp__ps-title">PRECISA DE AJUDA?</h2>
          <a href="https://wa.me/5511999999999?text=Ol%C3%A1%21%20Preciso%20de%20ajuda%20com%20o%20produto%3A%20{{ product.title | url_encode }}" target="_blank" rel="noopener" class="pdp__ps-btn">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="#25d366">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.98 3.8 13.46 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8.01 12.27C8.14 12.44 9.76 14.94 12.25 16.08C14.28 16.99 14.74 16.82 15.18 16.77C15.62 16.72 16.62 16.1 16.83 15.45C17.04 14.81 17.04 14.26 16.97 14.14C16.9 14.02 16.73 13.96 16.48 13.83C16.23 13.71 15.01 13.11 14.78 13.03C14.56 12.95 14.39 12.91 14.23 13.16C14.07 13.41 13.57 13.96 13.43 14.14C13.29 14.31 13.15 14.33 12.9 14.21C12.65 14.08 11.87 13.83 10.95 13.01C10.22 12.35 9.72 11.54 9.58 11.29C9.44 11.04 9.57 10.91 9.69 10.78C9.8 10.67 9.94 10.49 10.07 10.35C10.19 10.21 10.24 10.11 10.32 9.94C10.4 9.77 10.36 9.63 10.29 9.5C10.23 9.38 9.73 8.15 9.53 7.65C9.33 7.18 9.13 7.23 8.98 7.23C8.84 7.22 8.68 7.33 8.53 7.33Z"/>
            </svg>
            <span>PERSONAL SHOPPER</span>
          </a>
        </div>

        {% comment %} Compartilhar {% endcomment %}
        <div class="pdp__share">
          <button class="pdp__share-btn" id="share-btn" aria-label="Compartilhar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/>
              <polyline points="16 6 12 2 8 6"/>
              <line x1="12" y1="2" x2="12" y2="15"/>
            </svg>
            <span>Compartilhar</span>
          </button>
        </div>

      </div>
    </div>
  </div>

  {% comment %} ===== COMPRE O LOOK (automático por nome base) =====
    Lógica: tira o tipo da peça (Blusa, Saia, Shorts, etc.) do início do nome
    e procura outros produtos na mesma coleção com o mesmo nome base.
    Ex: "Casaco Tricot Melissa Azul" encontra "Shorts Tricot Melissa Azul"
  {% endcomment %}

  {% comment %} Extrair nome base do produto atual {% endcomment %}
  {% assign current_title = product.title %}
  {% assign title_words = current_title | split: ' ' %}
  {% assign first_word = title_words[0] | downcase %}

  {% comment %} Lista de tipos de peça para remover {% endcomment %}
  {% assign tipos = 'blusa,saia,calca,calça,shorts,short,vestido,casaco,cardigan,jaqueta,top,cropped,regata,body,macacao,macacão,conjunto,bolsa,cinto,cachecol,gorro,luva,meia,pantufa,kimono,poncho,colete,camisa,blazer,sobretudo' | split: ',' %}

  {% assign base_name = current_title %}
  {% for tipo in tipos %}
    {% if first_word == tipo %}
      {% comment %} Remover a primeira palavra (tipo da peça) {% endcomment %}
      {% assign base_name = current_title | remove_first: title_words[0] | strip %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% comment %} Remover "Tricot " do início se sobrou {% endcomment %}
  {% assign base_words = base_name | split: ' ' %}
  {% assign base_first = base_words[0] | downcase %}
  {% if base_first == 'tricot' %}
    {% assign base_name = base_name | remove_first: base_words[0] | strip %}
  {% endif %}

  {% comment %} Procurar produtos com mesmo nome base na coleção "all" {% endcomment %}
  {% assign look_matches = '' %}
  {% assign look_count = 0 %}
  {% assign look_total = product.price %}

  {% for p in collections.all.products limit: 200 %}
    {% if p.id != product.id %}
      {% assign p_title = p.title %}
      {% if p_title contains base_name and base_name.size > 3 %}
        {% comment %} Verificar se NÃO é o mesmo tipo de peça (evitar 2 blusas iguais) {% endcomment %}
        {% assign p_words = p_title | split: ' ' %}
        {% assign p_first = p_words[0] | downcase %}
        {% if p_first != first_word %}
          {% assign look_count = look_count | plus: 1 %}
          {% assign look_total = look_total | plus: p.price %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if look_count > 0 %}
    <section class="pdp__look">
      <h2 class="pdp__look-title">COMPRE O LOOK COMPLETO</h2>
      <div class="pdp__look-container">
        <div class="pdp__look-products">
          {% comment %} Produto atual {% endcomment %}
          <div class="pdp__look-item">
            <div class="pdp__look-img-wrap">
              <a href="{{ product.url }}">
                <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title }}" class="pdp__look-img" />
              </a>
            </div>
            {% for option in product.options_with_values %}
              {% assign oname = option.name | downcase %}
              {% if oname == 'tamanho' or oname == 'size' %}
                <div class="pdp__look-sizes">
                  {% for value in option.values %}
                    <span class="pdp__look-size">{{ value }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            {% endfor %}
            <div class="pdp__look-item-name">{{ product.title }}</div>
            <div class="pdp__look-item-price">{{ product.price | money }}</div>
          </div>

          {% comment %} Produtos complementares (mesmo nome base, tipo diferente) {% endcomment %}
          {% for p in collections.all.products limit: 200 %}
            {% if p.id != product.id %}
              {% assign p_title = p.title %}
              {% if p_title contains base_name and base_name.size > 3 %}
                {% assign p_words = p_title | split: ' ' %}
                {% assign p_first = p_words[0] | downcase %}
                {% if p_first != first_word %}
                  <div class="pdp__look-plus">+</div>
                  <div class="pdp__look-item">
                    <div class="pdp__look-img-wrap">
                      <a href="{{ p.url }}">
                        <img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.title }}" class="pdp__look-img" />
                      </a>
                    </div>
                    {% for option in p.options_with_values %}
                      {% assign oname = option.name | downcase %}
                      {% if oname == 'tamanho' or oname == 'size' %}
                        <div class="pdp__look-sizes">
                          {% for value in option.values %}
                            <span class="pdp__look-size">{{ value }}</span>
                          {% endfor %}
                        </div>
                      {% endif %}
                    {% endfor %}
                    <div class="pdp__look-item-name">{{ p.title }}</div>
                    <div class="pdp__look-item-price">{{ p.price | money }}</div>
                  </div>
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        {% comment %} Resumo {% endcomment %}
        <div class="pdp__look-summary">
          <div class="pdp__look-equals">=</div>
          <div class="pdp__look-summary-inner">
            <div class="pdp__look-summary-label">Compre os {{ look_count | plus: 1 }} produtos</div>
            <div class="pdp__look-summary-total">{{ look_total | money }}</div>
            {% assign look_installment = look_total | divided_by: 6 %}
            <div class="pdp__look-summary-installments">Em até 6x de {{ look_installment | money }}</div>
            <button class="pdp__look-buy-btn" id="look-buy-btn">COMPRAR LOOK</button>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {% comment %} Recomendações {% endcomment %}
  <section class="pdp__recommendations">
    <h2 class="pdp__recommendations-title">VOCÊ TAMBÉM VAI AMAR</h2>
    <div class="pdp__recommendations-grid">
      {% assign rec_collection = collections['all'] %}
      {% for p in rec_collection.products limit: 8 %}
        {% if p.id != product.id %}
          {% render 'product-card', product: p %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
</div>

<style>
  /* ========================================
     PDP – Página de Produto (estilo BP)
     Medidas conferidas via getComputedStyle
     ======================================== */

  .pdp {
    background: #ffffff;
    padding: 0;
  }

  /* --- Breadcrumb --- */
  .pdp__breadcrumb {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #545454;
    padding: 12px 40px;
    letter-spacing: 0.3px;
  }
  .pdp__breadcrumb a {
    color: #545454;
    text-decoration: none;
  }
  .pdp__breadcrumb a:hover {
    text-decoration: underline;
  }
  .pdp__breadcrumb-sep {
    margin: 0 6px;
    color: #999;
  }

  /* --- Container principal: 50/50 flex --- BP: max-width 1600px, padding 0 50px --- */
  .pdp__container {
    display: flex;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 50px;
    box-sizing: border-box;
  }

  /* --- Galeria (esquerda 50%) — carrossel horizontal como BP --- */
  .pdp__gallery {
    width: 50%;
    flex: 0 0 50%;
    position: relative;
    overflow: hidden;
  }
  .pdp__gallery-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 0;
  }
  .pdp__gallery-track::-webkit-scrollbar {
    display: none;
  }
  .pdp__gallery-item {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .pdp__gallery-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 2 / 3;
  }
  /* Setas */
  .pdp__gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    background: rgba(255,255,255,0.85);
    border: none;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #545454;
    transition: opacity 0.2s;
    border-radius: 50%;
  }
  .pdp__gallery-arrow:hover {
    background: rgba(255,255,255,1);
  }
  .pdp__gallery-arrow--prev { left: 12px; }
  .pdp__gallery-arrow--next { right: 12px; }
  /* Dots */
  .pdp__gallery-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 14px 0;
  }
  .pdp__gallery-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(84,84,84,0.25);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }
  .pdp__gallery-dot.is-active {
    background: #545454;
  }

  /* --- Info (direita 50%, sticky) --- */
  .pdp__info-wrapper {
    width: 50%;
    flex: 0 0 50%;
    position: relative;
  }
  .pdp__info {
    position: sticky;
    top: 90px; /* abaixo do header fixo (~80px) + margem */
    padding: 30px 50px 60px 50px;
    max-height: calc(100vh - 50px);
    overflow-y: auto;
  }
  /* Esconder scrollbar do info quando rola */
  .pdp__info::-webkit-scrollbar {
    width: 0;
    background: transparent;
  }

  /* --- Vendor --- */
  .pdp__vendor {
    font-family: 'Raleway', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 8px;
  }

  /* --- Título --- BP: Raleway 16px, 400, uppercase, 0.6px, #545454 --- */
  .pdp__title {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #545454;
    margin: 0 0 20px 0;
    line-height: 1.4;
  }

  /* --- Preço --- BP: Raleway 16px, 400, #545454 --- */
  .pdp__price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }
  .pdp__price-current {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #545454;
  }
  .pdp__price-current--sale {
    color: #c0392b;
  }
  .pdp__price-original {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #999;
    text-decoration: line-through;
  }

  /* --- Parcelamento --- BP: 16px --- */
  .pdp__installments {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #545454;
    margin-bottom: 28px;
  }

  /* --- Formulário --- */
  .pdp__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
  }

  /* --- Option label --- */
  .pdp__option {
    border: none;
    padding: 0;
    margin: 0;
  }
  .pdp__option-label {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.6px;
    color: #545454;
    margin-bottom: 12px;
    display: block;
    text-transform: uppercase;
  }
  .pdp__option-value {
    font-weight: 400;
    text-transform: none;
  }

  /* --- Color swatches (com imagem do produto) --- */
  .pdp__color-swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pdp__color-swatch {
    cursor: pointer;
    display: block;
    position: relative;
  }
  .pdp__color-swatch input {
    display: none;
  }
  .pdp__color-swatch-img {
    display: block;
    width: 56px;
    height: 72px;
    object-fit: cover;
    border: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .pdp__color-swatch input:checked + .pdp__color-swatch-img {
    border-color: #545454;
  }
  .pdp__color-swatch:hover .pdp__color-swatch-img {
    border-color: rgba(84, 84, 84, 0.4);
  }
  /* Fallback circular se não tiver imagem */
  .pdp__color-swatch-fallback {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid transparent;
    transition: border-color 0.2s;
  }
  .pdp__color-swatch input:checked + .pdp__color-swatch-fallback {
    border-color: #545454;
  }

  /* --- Size pills --- BP: clean pill style --- */
  .pdp__sizes {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pdp__size-pill {
    cursor: pointer;
    display: block;
  }
  .pdp__size-pill input {
    display: none;
  }
  .pdp__size-label {
    display: flex;
    align-items: center;
