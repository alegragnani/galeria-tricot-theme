</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    /* ---- Variant selection logic ---- */
    const productJson = {{ product | json }};
    const variantIdInput = document.getElementById('variant-id');
    const addBtn = document.getElementById('add-to-cart-btn');
    const form = document.getElementById('product-form');

    function getSelectedOptions() {
      const opts = {};
      if (!form) return opts;
      form.querySelectorAll('input[type="radio"]:checked, select').forEach(el => {
        const name = el.name.replace('options[', '').replace(']', '');
        opts[name] = el.value;
      });
      return opts;
    }

    function findVariant(opts) {
      return productJson.variants.find(v => {
        return productJson.options.every((optName, i) => {
          return v.options[i] === opts[optName];
        });
      });
    }

    function updateVariant() {
      const opts = getSelectedOptions();
      const variant = findVariant(opts);
      if (variant) {
        variantIdInput.value = variant.id;
        // Update price
        const priceEl = document.querySelector('.pdp__price-current');
        if (priceEl) {
          priceEl.textContent = (variant.price / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }
        // Update compare price
        const origEl = document.querySelector('.pdp__price-original');
        if (origEl) {
          if (variant.compare_at_price && variant.compare_at_price > variant.price) {
            origEl.textContent = (variant.compare_at_price / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            origEl.style.display = '';
          } else {
            origEl.style.display = 'none';
          }
        }
        // Update installments
        const instEl = document.querySelector('.pdp__installments');
        if (instEl) {
          const instVal = (variant.price / 100 / 6).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
          instEl.textContent = 'ou 6x de ' + instVal + ' sem juros';
        }
        // Button state
        if (variant.available) {
          addBtn.disabled = false;
          addBtn.textContent = 'ADICIONAR À SACOLA';
        } else {
          addBtn.disabled = true;
          addBtn.textContent = 'ESGOTADO';
        }
        // Update URL
        const url = new URL(window.location);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url);
      }
    }

    // Listen to option changes (form pode ser null em conjuntos)
    if (form) form.querySelectorAll('input[type="radio"], select').forEach(el => {
      el.addEventListener('change', function() {
        updateVariant();
        // Update option value display
        if (this.type === 'radio') {
          const legend = this.closest('fieldset').querySelector('.pdp__option-value');
          if (legend) legend.textContent = this.value;
        }
        // Se trocou cor, rolar galeria até a imagem da variante
        if (this.closest('.pdp__color-swatches')) {
          const opts = getSelectedOptions();
          const variant = findVariant(opts);
          if (variant && variant.featured_image) {
            const galleryImgs = document.querySelectorAll('.pdp__gallery-img');
            galleryImgs.forEach((img, idx) => {
              // Comparar pelo src (ambos terão parte do filename)
              if (img.src.includes(variant.featured_image.id) ||
                  img.alt === variant.featured_image.alt) {
                const item = img.closest('.pdp__gallery-item');
                if (item) item.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          }
        }
      });
    });

    /* ---- Add to cart ---- */
    if (form) form.addEventListener('submit', function(e) {
      e.preventDefault();
      addBtn.disabled = true;
      addBtn.textContent = 'ADICIONANDO...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{ id: parseInt(variantIdInput.value), quantity: 1 }]
        })
      })
      .then(res => {
        if (!res.ok) throw new Error('Erro');
        return res.json();
      })
      .then(() => {
        addBtn.textContent = 'ADICIONADO ✓';
        if (typeof openCartDrawer === 'function') openCartDrawer();
        setTimeout(() => {
          addBtn.disabled = false;
          addBtn.textContent = 'ADICIONAR À SACOLA';
        }, 2000);
      })
      .catch(() => {
        addBtn.disabled = false;
        addBtn.textContent = 'ADICIONAR À SACOLA';
        alert('Erro ao adicionar ao carrinho. Tente novamente.');
      });
    });

    /* ---- Gallery Carousel ---- */
    const track = document.getElementById('gallery-track');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    const dots = document.querySelectorAll('.pdp__gallery-dot');
    let currentSlide = 0;
    const totalSlides = document.querySelectorAll('.pdp__gallery-item').length;

    function goToSlide(idx) {
      if (idx < 0) idx = totalSlides - 1;
      if (idx >= totalSlides) idx = 0;
      currentSlide = idx;
      if (track) {
        const item = track.children[idx];
        if (item) {
          track.scrollTo({ left: item.offsetLeft, behavior: 'smooth' });
        }
      }
      dots.forEach((d, i) => d.classList.toggle('is-active', i === currentSlide));
    }

    prevBtn?.addEventListener('click', () => goToSlide(currentSlide - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentSlide + 1));
    dots.forEach(dot => {
      dot.addEventListener('click', () => goToSlide(parseInt(dot.dataset.index)));
    });

    // Sync dots on manual scroll
    if (track) {
      let scrollTimeout;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const scrollLeft = track.scrollLeft;
          const itemWidth = track.children[0]?.offsetWidth || 1;
          const newIndex = Math.round(scrollLeft / itemWidth);
          if (newIndex !== currentSlide && newIndex >= 0 && newIndex < totalSlides) {
            currentSlide = newIndex;
            dots.forEach((d, i) => d.classList.toggle('is-active', i === currentSlide));
          }
        }, 80);
      });
    }

    /* ---- Share ---- */
    document.getElementById('share-btn')?.addEventListener('click', function() {
      if (navigator.share) {
        navigator.share({ title: productJson.title, url: window.location.href });
      } else {
        navigator.clipboard.writeText(window.location.href).then(() => {
          const span = this.querySelector('span');
          span.textContent = 'Link copiado!';
          setTimeout(() => { span.textContent = 'Compartilhar'; }, 2000);
        });
      }
    });

    /* ====================================================
       CORES IRMÃS + COMPRE O LOOK — via Shopify Search API
       Cada cor da Galeria Tricot é um produto separado.
       Ex: "Blusa Tricot Adelina Cobre" e "Blusa Tricot Adelina Preto"
       ==================================================== */

    const TIPOS_PECA = ['blusa','saia','calca','calça','shorts','short','vestido','casaco','cardigan',
      'jaqueta','top','cropped','regata','body','macacao','macacão','conjunto','bolsa','cinto',
      'cachecol','gorro','luva','meia','pantufa','kimono','poncho','colete','camisa','blazer',
      'sobretudo','bermuda','capa','pashmina','saída','polaina','biquíni','biquini','maiô','twin',
      'kaftan','túnica','camiseta','moletom','t-shirt','pullover','maxpull','cachequer','corselet',
      'suéter','embalagem','vale'];

    /* Cores compostas (2 palavras) — checar ANTES de assumir cor = última palavra */
    const CORES_COMPOSTAS = [
      'off white', 'dark brown', 'dark blue', 'dark green', 'dark grey',
      'cinza mescla', 'cinza claro', 'cinza escuro', 'cinza chumbo',
      'azul claro', 'azul escuro', 'azul marinho', 'azul celeste', 'azul royal',
      'verde claro', 'verde escuro', 'verde militar', 'verde musgo', 'verde oliva', 'verde pistache',
      'rosa claro', 'rosa escuro', 'rosa pink', 'rosa blush', 'rosa chiclete',
      'marrom claro', 'marrom escuro', 'marrom cafe',
      'vermelho escuro', 'vermelho vivo',
      'amarelo claro', 'amarelo ouro',
      'bege claro', 'bege escuro',
      'nude rose', 'old rose',
      'new off', 'light pink', 'light blue', 'light grey',
      'marsala dark', 'vinho dark', 'bordo dark', 'cobre dark', 'nude dark',
      'bege dark', 'caramelo dark', 'chocolate dark', 'terracota dark',
      'preto mescla', 'marinho mescla', 'azul mescla',
      'coral dark', 'areia dark', 'ferrugem dark'
    ];

    function extrairNomeBase(title) {
      const words = title.trim().split(/\s+/);
      const SKIP = new Set([...TIPOS_PECA, 'tricot', 'set', '+',
        'curta','curto','longa','longo','midi','mini','maxi','ampla','amplo','manga']);

      /* Se tem "+" no meio, pode ser 2 formatos:
         A) "Conjunto Colete + Saia Curta Celina Marinho" (tipo+tipo antes do nome)
         B) "Conjunto Tricot Bertha Casaco + Bermuda Preto" (nome antes do +)
         Pra B: pegar tudo DEPOIS do último "+" e filtrar tipos, o resto é nome+cor
         Pra A: pular tipos do inicio ate achar nome */
      var plusIdx = words.lastIndexOf('+');
      var remaining;

      if (plusIdx > 1) {
        /* Tem "+": tentar extrair do trecho DEPOIS do "+" */
        var afterPlus = words.slice(plusIdx + 1);
        /* Pular tipos/modificadores depois do + */
        var s = 0;
        while (s < afterPlus.length && SKIP.has(afterPlus[s].toLowerCase())) s++;
        var namePart = afterPlus.slice(s);

        if (namePart.length >= 2) {
          remaining = namePart;
        } else {
          /* Formato B: nome está ANTES do "+", cor está DEPOIS */
          var beforePlus = words.slice(0, plusIdx);
          var sb = 0;
          while (sb < beforePlus.length && SKIP.has(beforePlus[sb].toLowerCase())) sb++;
          var eb = beforePlus.length;
          while (eb > sb && SKIP.has(beforePlus[eb - 1].toLowerCase())) eb--;
          var nameBeforePlus = beforePlus.slice(sb, eb);
          var corWord = afterPlus.length > 0 ? afterPlus[afterPlus.length - 1] : '';
          remaining = nameBeforePlus.concat([corWord]);
        }
      } else {
        /* Sem "+": pular tipos/tricot do inicio */
        var start = 0;
        while (start < words.length && SKIP.has(words[start].toLowerCase())) start++;
        remaining = words.slice(start);
      }

      /* Checar se as últimas 2 palavras formam uma cor composta (ex: "Off White", "Dark Brown") */
      var corWords = 1;
      if (remaining.length >= 3) {
        var last2 = (remaining[remaining.length - 2] + ' ' + remaining[remaining.length - 1]).toLowerCase();
        if (CORES_COMPOSTAS.includes(last2)) corWords = 2;
      }

      var base = remaining.slice(0, remaining.length - corWords).join(' ');
      var cor = remaining.slice(remaining.length - corWords).join(' ');
      return { base: base, cor: cor, tipo: words[0].toLowerCase() };
    }

    async function buscarProdutos(query) {
      try {
        const resp = await fetch('/search/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product&resources[limit]=50');
        const data = await resp.json();
        return data.resources?.results?.products || [];
      } catch(e) { return []; }
    }

    // Mapa de cores em português → código CSS
    const MAPA_CORES = {
      'preto': '#1a1a1a', 'black': '#1a1a1a',
      'branco': '#ffffff', 'white': '#ffffff',
      'off': '#f5f0e8', 'off-white': '#f5f0e8', 'offwhite': '#f5f0e8',
      'cru': '#f5f0e8', 'natural': '#f0ead6',
      'bege': '#d4b896', 'nude': '#d4b896', 'areia': '#d4b896',
      'cobre': '#b87333', 'caramelo': '#c68e4e', 'ferrugem': '#b7410e',
      'marrom': '#6b3a2a', 'chocolate': '#5c3317', 'cacau': '#6b3a2a', 'cafe': '#6b3a2a',
      'cinza': '#999999', 'mescla': '#b0b0b0', 'chumbo': '#666666', 'grafite': '#4a4a4a',
      'azul': '#3a6ea5', 'marinho': '#1b2a4a', 'navy': '#1b2a4a', 'royal': '#2850a8',
      'celeste': '#87ceeb', 'baby': '#89cff0', 'turquesa': '#40e0d0',
      'verde': '#2e7d32', 'militar': '#4a5d23', 'musgo': '#6b705c', 'oliva': '#808000',
      'pistache': '#93c572', 'menta': '#98fb98', 'esmeralda': '#046307',
      'vermelho': '#c41e3a', 'rubi': '#9b111e', 'cereja': '#de3163',
      'vinho': '#722f37', 'burgundy': '#722f37', 'marsala': '#8e4a49', 'bordo': '#722f37',
      'rosa': '#f4a7bb', 'pink': '#ff69b4', 'blush': '#f0c8c8', 'chiclete': '#ff66b2',
      'magenta': '#c20078', 'fuchsia': '#ff00ff',
      'coral': '#ff7f50', 'salmon': '#fa8072', 'salmao': '#fa8072',
      'laranja': '#e67e22', 'tangerina': '#ff9944', 'terracota': '#cc5533',
      'amarelo': '#f1c40f', 'mostarda': '#c7a93e', 'ouro': '#c7a93e', 'dourado': '#c7a93e',
      'lilas': '#c8a2c8', 'lavanda': '#b57edc', 'roxo': '#6a0dad', 'uva': '#6a0040',
      'violeta': '#7f00ff', 'ameixa': '#673147',
      'prata': '#c0c0c0', 'silver': '#c0c0c0',
      'neon': '#39ff14', 'limao': '#bfff00', 'lima': '#bfff00',
      'rost': '#b7410e', 'tijolo': '#cb4154',
      'darkbrown': '#4a2c17', 'dark brown': '#4a2c17',
      'darkblue': '#1b2a4a', 'dark blue': '#1b2a4a',
      'marsaladark': '#6b3040', 'marsala dark': '#6b3040',
      'cinzamescla': '#b0b0b0', 'cinza mescla': '#b0b0b0',
      'offwhite': '#f5f0e8', 'off white': '#f5f0e8',
      'multicolor': 'conic-gradient(#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00)',
      'colorido': 'conic-gradient(#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00)',
      'estampado': 'conic-gradient(#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00)',
    };

    function corParaCSS(nomeCor) {
      const lowerSpaced = nomeCor.toLowerCase()
        .normalize('NFD').replace(/[̀-ͯ]/g, '');
      const lower = lowerSpaced.replace(/\s+/g, '');
      // Tentar match direto (com e sem espaço)
      if (MAPA_CORES[lower]) return MAPA_CORES[lower];
      if (MAPA_CORES[lowerSpaced.trim()]) return MAPA_CORES[lowerSpaced.trim()];
      // Tentar match parcial (ex: "Cinza Mescla" → "cinza")
      for (const [key, val] of Object.entries(MAPA_CORES)) {
        if (lower.includes(key) || key.includes(lower)) return val;
      }
      // Fallback: cinza neutro
      return '#cccccc';
    }

    /* ---- Extrair modelo + cor DIRETO do título (sem depender de lista de cores) ----
       Lógica: tipo e "tricot" e modificadores ficam no início.
       A PRIMEIRA palavra significativa = nome do modelo (Raquel, Eva, Adelina...).
       TUDO depois do modelo = cor (1, 2 ou 3 palavras — não importa).
       Ex: "Calça Tricot Raquel Marsala Dark" → modelo=Raquel, cor=Marsala Dark
       Ex: "Blusa Tricot Adelina Cobre" → modelo=Adelina, cor=Cobre
    */
    function extrairModeloCor(title) {
      const words = title.trim().split(/\s+/);
      const SKIP = new Set([...TIPOS_PECA, 'tricot', 'set', '+',
        'curta','curto','longa','longo','midi','mini','maxi','ampla','amplo','manga']);
      let i = 0;
      while (i < words.length && SKIP.has(words[i].toLowerCase())) i++;
      if (i >= words.length) return { modelo: '', cor: '', tipo: words[0] ? words[0].toLowerCase() : '' };
      const modelo = words[i];
      const cor = words.slice(i + 1).join(' ');
      return { modelo: modelo, cor: cor, tipo: words[0] ? words[0].toLowerCase() : '' };
    }

    async function carregarCoresIrmas() {
      const title = productJson.title;
      const { modelo, cor, tipo } = extrairModeloCor(title);
      if (!modelo || modelo.length < 2) return;

      const container = document.getElementById('sibling-swatches');
      const colorLabel = document.getElementById('current-color-name');

      // Gerar URL menor para thumbnail (300px de largura)
      function thumbUrl(src) {
        if (!src) return '';
        return src.replace(/(\.\w+)(\?|$)/, '_300x$1$2');
      }

      // Buscar última imagem (still) de um produto via /products/handle.json
      async function buscarUltimaImagem(handle) {
        try {
          const resp = await fetch('/products/' + handle + '.json');
          const data = await resp.json();
          const imgs = data.product && data.product.images;
          if (imgs && imgs.length > 0) return imgs[imgs.length - 1].src;
        } catch(e) {}
        return '';
      }

      // Produto atual: usar última foto (still)
      const allImgs = productJson.images || [];
      const lastImg = allImgs.length > 0 ? allImgs[allImgs.length - 1] : productJson.featured_image || '';
      const currentImgSrc = typeof lastImg === 'string' ? lastImg : (lastImg.src || '');

      let html = '<a class="pdp__sibling-link is-current" href="' + window.location.pathname + '" title="' + cor + '">' +
        '<img src="' + thumbUrl(currentImgSrc) + '" alt="' + cor + '" loading="lazy" />' +
        '</a>';

      // Buscar produtos irmãos: mesmo modelo + mesmo tipo, cor diferente
      const results = await buscarProdutos(modelo);
      const coresVistas = new Set([cor.toLowerCase()]);
      const siblings = results.filter(p => {
        if (p.url === window.location.pathname) return false;
        const { modelo: pModelo, cor: pCor, tipo: pTipo } = extrairModeloCor(p.title);
        if (pTipo !== tipo) return false;
        if (pModelo.toLowerCase() !== modelo.toLowerCase()) return false;
        const pCorLower = (pCor || '').toLowerCase();
        if (!pCorLower || coresVistas.has(pCorLower)) return false;
        coresVistas.add(pCorLower);
        return true;
      });

      // Buscar última imagem (still) de cada irmão em paralelo
      const siblingData = await Promise.all(siblings.map(async p => {
        const { cor: pCor } = extrairModeloCor(p.title);
        const handle = p.url.replace('/products/', '').replace(/\/$/, '');
        const stillImg = await buscarUltimaImagem(handle);
        const fallbackImg = (p.featured_image && p.featured_image.url) || p.image || '';
        return { url: p.url, cor: pCor, img: stillImg || fallbackImg };
      }));

      siblingData.forEach(s => {
        html += '<a class="pdp__sibling-link" href="' + s.url + '" title="' + s.cor + '">' +
          '<img src="' + thumbUrl(s.img) + '" alt="' + s.cor + '" loading="lazy" />' +
          '</a>';
      });

      container.innerHTML = html;
      if (colorLabel) colorLabel.textContent = cor;
    }

    async function carregarCompreOLook() {
      const title = productJson.title;
      const { base, cor, tipo } = extrairNomeBase(title);
      if (!base || base.length < 2) return;

      // Buscar pelo nome base + cor (ex: "Melissa Azul") para achar peças complementares
      const query = base + ' ' + cor;
      const results = await buscarProdutos(query);

      // Filtrar: mesmo base+cor, tipo DIFERENTE, sem conjuntos (conjunto é o bundle, nao peca avulsa)
      const lookItems = results.filter(p => {
        if (p.url === window.location.pathname) return false;
        const { base: pBase, cor: pCor, tipo: pTipo } = extrairNomeBase(p.title);
        if (pTipo === 'conjunto' || pTipo === 'twin') return false;
        return pBase === base && pCor === cor && pTipo !== tipo;
      });

      if (lookItems.length === 0) return;

      const section = document.getElementById('look-section');
      const container = document.getElementById('look-container');

      // Calcular total
      const currentPrice = productJson.price / 100;
      let totalPrice = currentPrice;
      lookItems.forEach(p => { totalPrice += parseFloat(p.price) || 0; });

      const fmt = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

      let html = '<div class="pdp__look-products">';
      // Produto atual
      html += '<div class="pdp__look-item">' +
        '<div class="pdp__look-img-wrap"><a href="' + window.location.pathname + '">' +
        '<img src="' + productJson.featured_image + '" alt="' + productJson.title + '" class="pdp__look-img" />' +
        '</a></div>' +
        '<div class="pdp__look-item-name">' + productJson.title + '</div>' +
        '<div class="pdp__look-item-price">' + fmt(currentPrice) + '</div></div>';

      // Complementares
      lookItems.forEach(p => {
        const imgSrc = p.featured_image?.url || p.image || '';
        const price = parseFloat(p.price) || 0;
        html += '<div class="pdp__look-plus">+</div>' +
          '<div class="pdp__look-item">' +
          '<div class="pdp__look-img-wrap"><a href="' + p.url + '">' +
          '<img src="' + imgSrc + '" alt="' + p.title + '" class="pdp__look-img" />' +
          '</a></div>' +
          '<div class="pdp__look-item-name">' + p.title + '</div>' +
          '<div class="pdp__look-item-price">' + fmt(price) + '</div></div>';
      });

      html += '</div>'; // fim look-products

      // Resumo
      const totalQtd = lookItems.length + 1;
      const parcela = totalPrice / 6;
      html += '<div class="pdp__look-summary">' +
        '<div class="pdp__look-equals">=</div>' +
        '<div class="pdp__look-summary-inner">' +
        '<div class="pdp__look-summary-label">Compre os ' + totalQtd + ' produtos</div>' +
        '<div class="pdp__look-summary-total">' + fmt(totalPrice) + '</div>' +
        '<div class="pdp__look-summary-installments">Em até 6x de ' + fmt(parcela) + '</div>' +
        '<button class="pdp__look-buy-btn" id="look-buy-btn">COMPRAR LOOK</button>' +
        '</div></div>';

      container.innerHTML = html;
      section.style.display = '';

      // Botão comprar look — adiciona todos ao carrinho
      document.getElementById('look-buy-btn')?.addEventListener('click', async function() {
        this.disabled = true;
        this.textContent = 'ADICIONANDO...';
        try {
          // Adicionar produto atual
          const items = [{ id: parseInt(variantIdInput.value), quantity: 1 }];
          // Para os complementares precisamos do variant ID — por enquanto redirecionar para o carrinho
          // (a API de search não retorna variant_id facilmente)
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
          });
          // Redirecionar para carrinho
          window.location.href = '/cart';
        } catch(e) {
          this.disabled = false;
          this.textContent = 'COMPRAR LOOK';
        }
      });
    }

    /* ====================================================
       CONJUNTO (bundle) — interacao (checkbox, tamanho, add to cart)
       As pecas ja vem renderizadas server-side via metafield.
       ==================================================== */

    const isConjunto = productJson.title.toLowerCase().startsWith('conjunto');

    function iniciarConjunto() {
      const container = document.getElementById('conjunto-items');
      const totalEl = document.getElementById('conjunto-total');
      const addBtn = document.getElementById('conjunto-add-btn');
      const instEl = document.getElementById('conjunto-installments');
      const headerInstEl = document.querySelector('.conjunto__header-installments');
      if (!container || !addBtn) return;

      var fmt = function(v) { return (v / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); };

      function atualizarTotal() {
        var total = 0;
        container.querySelectorAll('.conjunto__item').forEach(function(item) {
          var cb = item.querySelector('.conjunto__item-check');
          if (!cb || !cb.checked) return;
          var selected = item.querySelector('.conjunto__size-pill.is-selected');
          if (selected) total += parseInt(selected.getAttribute('data-price') || '0');
        });
        if (totalEl) totalEl.textContent = fmt(total);
        var instText = total > 0 ? 'ou 6x de ' + fmt(Math.round(total / 6)) + ' sem juros' : '';
        if (instEl) instEl.textContent = instText;
        if (headerInstEl) headerInstEl.textContent = instText;

        var anyChecked = container.querySelector('.conjunto__item-check:checked');
        addBtn.disabled = !anyChecked;
      }

      // Eventos: checkboxes
      container.querySelectorAll('.conjunto__item-check').forEach(function(cb) {
        cb.addEventListener('change', atualizarTotal);
      });

      // Eventos: tamanhos
      container.querySelectorAll('.conjunto__size-pill').forEach(function(pill) {
        pill.addEventListener('click', function() {
          if (this.classList.contains('is-soldout')) return;
          // Desmarcar pills do mesmo item
          this.closest('.conjunto__item-sizes').querySelectorAll('.conjunto__size-pill').forEach(function(p) {
            p.classList.remove('is-selected');
          });
          this.classList.add('is-selected');
          // Atualizar preco do item
          var priceEl = this.closest('.conjunto__item').querySelector('.conjunto__item-price');
          if (priceEl) priceEl.textContent = fmt(parseInt(this.getAttribute('data-price') || '0'));
          atualizarTotal();
        });
      });

      // Botao adicionar conjunto ao carrinho
      addBtn.addEventListener('click', async function() {
        addBtn.disabled = true;
        addBtn.textContent = 'ADICIONANDO...';

        var items = [];
        container.querySelectorAll('.conjunto__item').forEach(function(item) {
          var cb = item.querySelector('.conjunto__item-check');
          if (!cb || !cb.checked) return;
          var selected = item.querySelector('.conjunto__size-pill.is-selected');
          if (selected && selected.getAttribute('data-available') === 'true') {
            items.push({ id: parseInt(selected.getAttribute('data-variant-id')), quantity: 1 });
          }
        });

        if (items.length === 0) {
          addBtn.textContent = 'SELECIONE PELO MENOS 1 ITEM';
          setTimeout(function() { addBtn.textContent = 'ADICIONAR CONJUNTO A SACOLA'; addBtn.disabled = false; }, 2000);
          return;
        }

        try {
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items })
          });
          addBtn.textContent = 'ADICIONADO!';
          if (typeof openCartDrawer === 'function') openCartDrawer();
          setTimeout(function() { addBtn.textContent = 'ADICIONAR CONJUNTO À SACOLA'; addBtn.disabled = false; }, 2000);
        } catch(e) {
          addBtn.textContent = 'ERRO - TENTE NOVAMENTE';
          setTimeout(function() { addBtn.textContent = 'ADICIONAR CONJUNTO A SACOLA'; addBtn.disabled = false; }, 2000);
        }
      });
    }

    // Executar conforme tipo de produto
    if (isConjunto) {
      iniciarConjunto();
    } else {
      carregarCoresIrmas();
      carregarCompreOLook();
    }
  });
</script>

