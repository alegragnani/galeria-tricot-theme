</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    /* ---- Variant selection logic ---- */
    const productJson = {{ product | json }};
    const variantIdInput = document.getElementById('variant-id');
    const addBtn = document.getElementById('add-to-cart-btn');
    const form = document.getElementById('product-form');

    function getSelectedOptions() {
      const opts = {};
      form.querySelectorAll('input[type="radio"]:checked, select').forEach(el => {
        const name = el.name.replace('options[', '').replace(']', '');
        opts[name] = el.value;
      });
      return opts;
    }

    function findVariant(opts) {
      return productJson.variants.find(v => {
        return productJson.options.every((optName, i) => {
          return v.options[i] === opts[optName];
        });
      });
    }

    function updateVariant() {
      const opts = getSelectedOptions();
      const variant = findVariant(opts);
      if (variant) {
        variantIdInput.value = variant.id;
        // Update price
        const priceEl = document.querySelector('.pdp__price-current');
        if (priceEl) {
          priceEl.textContent = (variant.price / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }
        // Update compare price
        const origEl = document.querySelector('.pdp__price-original');
        if (origEl) {
          if (variant.compare_at_price && variant.compare_at_price > variant.price) {
            origEl.textContent = (variant.compare_at_price / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            origEl.style.display = '';
          } else {
            origEl.style.display = 'none';
          }
        }
        // Update installments
        const instEl = document.querySelector('.pdp__installments');
        if (instEl) {
          const instVal = (variant.price / 100 / 6).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
          instEl.textContent = 'ou 6x de ' + instVal + ' sem juros';
        }
        // Button state
        if (variant.available) {
          addBtn.disabled = false;
          addBtn.textContent = 'ADICIONAR À SACOLA';
        } else {
          addBtn.disabled = true;
          addBtn.textContent = 'ESGOTADO';
        }
        // Update URL
        const url = new URL(window.location);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url);
      }
    }

    // Listen to option changes
    form.querySelectorAll('input[type="radio"], select').forEach(el => {
      el.addEventListener('change', function() {
        updateVariant();
        // Update option value display
        if (this.type === 'radio') {
          const legend = this.closest('fieldset').querySelector('.pdp__option-value');
          if (legend) legend.textContent = this.value;
        }
        // Se trocou cor, rolar galeria até a imagem da variante
        if (this.closest('.pdp__color-swatches')) {
          const opts = getSelectedOptions();
          const variant = findVariant(opts);
          if (variant && variant.featured_image) {
            const galleryImgs = document.querySelectorAll('.pdp__gallery-img');
            galleryImgs.forEach((img, idx) => {
              // Comparar pelo src (ambos terão parte do filename)
              if (img.src.includes(variant.featured_image.id) ||
                  img.alt === variant.featured_image.alt) {
                const item = img.closest('.pdp__gallery-item');
                if (item) item.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          }
        }
      });
    });

    /* ---- Add to cart ---- */
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      addBtn.disabled = true;
      addBtn.textContent = 'ADICIONANDO...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{ id: parseInt(variantIdInput.value), quantity: 1 }]
        })
      })
      .then(res => {
        if (!res.ok) throw new Error('Erro');
        return res.json();
      })
      .then(() => {
        addBtn.textContent = 'ADICIONADO ✓';
        setTimeout(() => {
          addBtn.disabled = false;
          addBtn.textContent = 'ADICIONAR À SACOLA';
        }, 2000);
      })
      .catch(() => {
        addBtn.disabled = false;
        addBtn.textContent = 'ADICIONAR À SACOLA';
        alert('Erro ao adicionar ao carrinho. Tente novamente.');
      });
    });

    /* ---- Gallery Carousel ---- */
    const track = document.getElementById('gallery-track');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    const dots = document.querySelectorAll('.pdp__gallery-dot');
    let currentSlide = 0;
    const totalSlides = document.querySelectorAll('.pdp__gallery-item').length;

    function goToSlide(idx) {
      if (idx < 0) idx = totalSlides - 1;
      if (idx >= totalSlides) idx = 0;
      currentSlide = idx;
      if (track) {
        const item = track.children[idx];
        if (item) {
          track.scrollTo({ left: item.offsetLeft, behavior: 'smooth' });
        }
      }
      dots.forEach((d, i) => d.classList.toggle('is-active', i === currentSlide));
    }

    prevBtn?.addEventListener('click', () => goToSlide(currentSlide - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentSlide + 1));
    dots.forEach(dot => {
      dot.addEventListener('click', () => goToSlide(parseInt(dot.dataset.index)));
    });

    // Sync dots on manual scroll
    if (track) {
      let scrollTimeout;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const scrollLeft = track.scrollLeft;
          const itemWidth = track.children[0]?.offsetWidth || 1;
          const newIndex = Math.round(scrollLeft / itemWidth);
          if (newIndex !== currentSlide && newIndex >= 0 && newIndex < totalSlides) {
            currentSlide = newIndex;
            dots.forEach((d, i) => d.classList.toggle('is-active', i === currentSlide));
          }
        }, 80);
      });
    }

    /* ---- Share ---- */
    document.getElementById('share-btn')?.addEventListener('click', function() {
      if (navigator.share) {
        navigator.share({ title: productJson.title, url: window.location.href });
      } else {
        navigator.clipboard.writeText(window.location.href).then(() => {
          const span = this.querySelector('span');
          span.textContent = 'Link copiado!';
          setTimeout(() => { span.textContent = 'Compartilhar'; }, 2000);
        });
      }
    });
  });
</script>

