            <span>Compartilhar</span>
          </button>
        </div>

      </div>
    </div>
  </div>

  {% comment %} ===== COMPRE O LOOK (carregado via JS — busca API Shopify) ===== {% endcomment %}
  <section class="pdp__look" id="look-section" style="display:none;">
    <h2 class="pdp__look-title">COMPRE O LOOK COMPLETO</h2>
    <div class="pdp__look-container" id="look-container"></div>
  </section>

  {% comment %} Recomendações {% endcomment %}
  <section class="pdp__recommendations">
    <h2 class="pdp__recommendations-title">VOCÊ TAMBÉM VAI AMAR</h2>
    <div class="pdp__recommendations-grid">
      {% comment %} Regra: peça da Sale → mesma aba da Sale; peça de coleção → mesma coleção; senão, geral {% endcomment %}
      {% assign rec_collection = blank %}
      {% assign sale_abas = 'sale-blusas,sale-calcas,sale-casacos,sale-conjuntos,sale-saias,sale-shorts,sale-vestidos,outlet-blusas,outlet-calcas,outlet-casacos,outlet-conjuntos,outlet-saias,outlet-shorts,outlet-vestidos,conjuntos-outlet' | split: ',' %}
      {% for c in product.collections %}
        {% if sale_abas contains c.handle %}
          {% assign rec_collection = c %}
          {% break %}
        {% endif %}
      {% endfor %}
      {% if rec_collection == blank %}
        {% for c in product.collections %}
          {% if c.handle contains 'sale' or c.handle contains 'outlet' or c.handle contains 'off-tricot' %}
            {% assign rec_collection = c %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% if rec_collection == blank %}
        {% for c in product.collections %}
          {% if c.handle == 'novidades' or c.handle == 'aerolooks' or c.handle == 'mom-edit' or c.handle == 'snow-trip-collab' or c.handle == 'euro-summer' %}
            {% assign rec_collection = c %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% if rec_collection == blank %}{% assign rec_collection = collections['all'] %}{% endif %}
      {% assign rec_shown = 0 %}
      {% for p in rec_collection.products limit: 12 %}
        {% if p.id != product.id and rec_shown < 8 %}
          {% render 'product-card', product: p %}
          {% assign rec_shown = rec_shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
</div>

<style>
  /* ========================================
     PDP – Página de Produto (estilo BP)
     Medidas conferidas via getComputedStyle
     ======================================== */

  .pdp {
    background: #ffffff;
    padding: 0;
  }

  /* --- Breadcrumb --- BP: max-width 1600, alinhado com container --- */
  .pdp__breadcrumb {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #545454;
    padding: 12px 50px;
    letter-spacing: 0.6px;
    max-width: 1600px;
    margin: 0 auto;
    box-sizing: border-box;
  }
  .pdp__breadcrumb a {
    color: rgba(84, 84, 84, 0.5);
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.6px;
    transition: color 0.2s;
  }
  .pdp__breadcrumb a:hover {
    color: #545454;
    text-decoration: none;
  }
  .pdp__breadcrumb-sep {
    margin: 0 8px;
    color: rgba(84, 84, 84, 0.5);
  }
  @media (max-width: 768px) {
    .pdp__breadcrumb { display: none; }
  }

  /* --- Container principal: 50/50 flex --- BP: max-width 1600px, padding 0 50px --- */
  .pdp__container {
    display: flex;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 50px;
    box-sizing: border-box;
  }

  /* --- Galeria (esquerda 50%) — carrossel horizontal como BP --- */
  .pdp__gallery {
    width: 50%;
    flex: 0 0 50%;
    position: relative;
  }
  .pdp__gallery-track {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 0;
  }
  .pdp__gallery-track::-webkit-scrollbar {
    display: none;
  }
  .pdp__gallery-item {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .pdp__gallery-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 2 / 3;
  }
  /* Setas */
  .pdp__gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    background: rgba(255,255,255,0.85);
    box-shadow: 0 1px 4px rgba(0,0,0,0.12);
    border: none;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #B3883D;
    transition: background 0.2s;
    border-radius: 50%;
  }
  .pdp__gallery-arrow:hover {
    background: #ffffff;
  }
  .pdp__gallery-arrow--prev { left: 12px; }
  .pdp__gallery-arrow--next { right: 12px; }
  /* Dots */
  .pdp__gallery-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 14px 0;
  }
  .pdp__gallery-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(84,84,84,0.25);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }
  .pdp__gallery-dot.is-active {
    background: #545454;
  }

  /* --- Info (direita 50%, sticky) --- */
  .pdp__info-wrapper {
    width: 50%;
    flex: 0 0 50%;
    position: relative;
  }
  .pdp__info {
    position: sticky;
    top: 90px; /* abaixo do header fixo (~80px) + margem */
    padding: 30px 50px 60px 50px;
    max-height: calc(100vh - 50px);
    overflow-y: auto;
  }
  /* Esconder scrollbar do info quando rola */
  .pdp__info::-webkit-scrollbar {
    width: 0;
    background: transparent;
  }

  /* --- Vendor --- */
  .pdp__vendor {
    font-family: 'Raleway', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 8px;
  }

  /* --- Título --- Raleway 20px, 400, uppercase, 0.6px, #545454 --- */
  .pdp__title {
    font-family: 'Raleway', sans-serif;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #545454;
    margin: 0 0 20px 0;
    line-height: 1.4;
  }

  /* --- Preço --- BP: Raleway 16px, 400, #545454 --- */
  .pdp__price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }
  .pdp__price-current {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #545454;
  }
  .pdp__price-current--sale {
    color: #c0392b;
  }
  .pdp__price-original {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #999;
    text-decoration: line-through;
  }

  /* --- Parcelamento --- BP: 16px --- */
  .pdp__installments {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #545454;
    margin-bottom: 28px;
  }

  /* --- Formulário --- */
  .pdp__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
  }

  /* --- Option label --- */
  .pdp__option {
    border: none;
    padding: 0;
    margin: 0;
  }
  .pdp__option-label {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.6px;
    color: #545454;
    margin-bottom: 12px;
    display: block;
    text-transform: uppercase;
  }
  .pdp__option-value {
    font-weight: 400;
    text-transform: none;
  }

  /* --- Color swatches (variantes dentro do mesmo produto, se houver) --- */
  .pdp__color-swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pdp__color-swatch {
    cursor: pointer;
    display: block;
    position: relative;
  }
  .pdp__color-swatch input { display: none; }
  .pdp__color-swatch-img {
    display: block;
    width: 60px;
    height: 78px;
    object-fit: cover;
    border: 1.5px solid rgba(84, 84, 84, 0.15);
    transition: border-color 0.25s;
  }
  .pdp__color-swatch input:checked + .pdp__color-swatch-img { border-color: #545454; }
  .pdp__color-swatch:hover .pdp__color-swatch-img { border-color: rgba(84, 84, 84, 0.5); }
  .pdp__color-swatch-fallback {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid rgba(84, 84, 84, 0.15);
    transition: border-color 0.25s;
    box-shadow: inset 0 0 0 2px #fff;
  }
  .pdp__color-swatch input:checked + .pdp__color-swatch-fallback { border-color: #545454; }
  .pdp__color-swatch:hover .pdp__color-swatch-fallback { border-color: rgba(84, 84, 84, 0.5); }

  /* --- Sibling colors (mini foto do produto — cada cor é produto separado) --- */
  .pdp__siblings {
    margin-bottom: 24px;
  }
  .pdp__sibling-swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .pdp__sibling-link {
    display: block;
    width: 52px;
    height: 68px;
    border: 1.5px solid rgba(84, 84, 84, 0.15);
    transition: border-color 0.25s;
    text-decoration: none;
    overflow: hidden;
  }
  .pdp__sibling-link.is-current {
    border-color: #545454;
  }
  .pdp__sibling-link:hover {
    border-color: rgba(84, 84, 84, 0.5);
  }
  .pdp__sibling-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Size pills --- BP: clean pill style --- */
  .pdp__sizes {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pdp__size-pill {
    cursor: pointer;
    display: block;
  }
  .pdp__size-pill input {
    display: none;
  }
  .pdp__size-label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 44px;
    padding: 0 16px;
    border: 1px solid rgba(84, 84, 84, 0.25);
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #545454;
    letter-spacing: 0.3px;
    transition: all 0.2s;
    background: #ffffff;
  }
  .pdp__size-pill input:checked + .pdp__size-label {
    border-color: #545454;
    background: #545454;
    color: #ffffff;
  }
  .pdp__size-label:hover {
    border-color: #545454;
  }
  /* Tamanho esgotado — riscado */
  .pdp__size-pill--soldout,
  .pdp__size-pill--soldout .pdp__size-label {
    cursor: default;
  }
  .pdp__size-pill--soldout .pdp__size-label {
    color: #c0c0c0;
    text-decoration: line-through;
    border-color: rgba(84, 84, 84, 0.12);
    background: #ffffff;
  }
  .pdp__size-pill--soldout .pdp__size-label:hover {
    border-color: rgba(84, 84, 84, 0.12);
  }

  /* --- Select (outras opções) --- */
  .pdp__select {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid rgba(84, 84, 84, 0.25);
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    color: #545454;
    background: #ffffff;
    appearance: none;
    cursor: pointer;
  }

  /* --- Aviso de pré-venda --- */
  .pdp__pre-venda {
    background: #FAF6F1;
    border: 1px solid rgba(179, 136, 61, 0.3);
    padding: 16px 20px;
    text-align: center;
  }
  .pdp__pre-venda-badge {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #B3883D;
    margin-bottom: 6px;
  }
  .pdp__pre-venda-date {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #545454;
    line-height: 1.4;
  }

  /* --- Botão Adicionar à Sacola --- BP: bg rgb(217,200,158), cor #545454, 47px, 80% da coluna --- */
  .pdp__add-to-cart {
    width: 80%;
    height: 47px;
    background: #B3883D;
    color: #ffffff;
    border: none;
    border-radius: 0;
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .pdp__add-to-cart:hover:not(:disabled) {
    opacity: 0.85;
  }
  .pdp__add-to-cart:disabled {
    background: #e0dcd4;
    color: #999;
    cursor: not-allowed;
  }

  /* --- Links auxiliares --- */
  .pdp__aux-links {
    padding: 16px 0;
  }
  .pdp__aux-link {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #545454;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pdp__aux-link:hover {
    color: #333;
  }

  /* --- Acordeões --- BP: borda top rgba(84,84,84,0.2), summary 16px Raleway --- */
  .pdp__accordions {
    margin-top: 24px;
  }
  .pdp__accordion {
    border-top: 1px solid rgba(84, 84, 84, 0.2);
  }
  .pdp__accordion:last-child {
    border-bottom: 1px solid rgba(84, 84, 84, 0.2);
  }
  .pdp__accordion-trigger {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.6px;
    color: #545454;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  .pdp__accordion-trigger::-webkit-details-marker {
    display: none;
  }
  .pdp__accordion-trigger::after {
    content: '+';
    font-size: 20px;
    font-weight: 300;
    color: #545454;
    transition: transform 0.25s;
  }
  details[open] > .pdp__accordion-trigger::after {
    content: '−';
  }
  .pdp__accordion-body {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7;
    color: #545454;
    padding: 0 0 20px 0;
  }

  /* --- Personal Shopper (WhatsApp) — estilo BP --- */
  .pdp__personal-shopper {
    margin: 24px 0 0;
    text-align: center;
  }
  .pdp__ps-title {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #545454;
    margin: 0 0 14px 0;
  }
  .pdp__ps-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 80%;
    height: 47px;
    border: 1px solid #9E885E;
    background: #ffffff;
    color: #9E885E;
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
    box-sizing: border-box;
  }
  .pdp__ps-btn:hover {
    background: #faf8f4;
  }
  .pdp__ps-btn svg {
    flex-shrink: 0;
  }

  /* --- Compartilhar --- */
  .pdp__share {
    margin-top: 20px;
    padding-top: 16px;
  }
  .pdp__share-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #545454;
    cursor: pointer;
    padding: 0;
    letter-spacing: 0.3px;
  }
  .pdp__share-btn:hover {
    color: #333;
  }

  /* ===== CONJUNTO (bundle) ===== */
  .conjunto { margin-top: 8px; }
  .conjunto__header {
    margin-bottom: 20px;
  }
  .conjunto__total-price {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #545454;
    margin-bottom: 6px;
  }
  .conjunto__header-installments {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #545454;
    margin-bottom: 28px;
  }
  .conjunto__items { display: flex; flex-direction: column; }
  .conjunto__item {
