{% comment %}
  Product page (PDP) – estilo BP
  Layout: galeria à esquerda (scroll vertical de imagens grandes) + info à direita (sticky)
  Medidas conferidas na BP via getComputedStyle em 22/abr/2026
{% endcomment %}

<div class="pdp">
  {% comment %} Breadcrumb {% endcomment %}
  <nav class="pdp__breadcrumb" aria-label="breadcrumb">
    <a href="/">Início</a>
    <span class="pdp__breadcrumb-sep">›</span>
    {% if collection %}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span class="pdp__breadcrumb-sep">›</span>
    {% endif %}
    <span>{{ product.title }}</span>
  </nav>

  <div class="pdp__container">
    {% comment %} ===== GALERIA (esquerda, 50%) ===== {% endcomment %}
    <div class="pdp__gallery">
      {% for image in product.images %}
        <div class="pdp__gallery-item">
          <img
            src="{{ image | image_url: width: 900 }}"
            alt="{{ image.alt | default: product.title }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            class="pdp__gallery-img"
          />
        </div>
      {% endfor %}
    </div>

    {% comment %} ===== INFO DO PRODUTO (direita, 50%, sticky) ===== {% endcomment %}
    <div class="pdp__info-wrapper">
      <div class="pdp__info">

        {% comment %} Vendor {% endcomment %}
        {% if product.vendor %}
          <div class="pdp__vendor">{{ product.vendor }}</div>
        {% endif %}

        {% comment %} Título {% endcomment %}
        <h1 class="pdp__title">{{ product.title }}</h1>

        {% comment %} Preço {% endcomment %}
        <div class="pdp__price">
          {% assign variant = product.selected_or_first_available_variant %}
          {% if variant.compare_at_price > variant.price %}
            <span class="pdp__price-original">{{ variant.compare_at_price | money }}</span>
          {% endif %}
          <span class="pdp__price-current {% if variant.compare_at_price > variant.price %}pdp__price-current--sale{% endif %}">
            {{ variant.price | money }}
          </span>
        </div>

        {% comment %} Parcelamento {% endcomment %}
        {% assign installment_value = variant.price | divided_by: 6 %}
        <div class="pdp__installments">
          ou 6x de {{ installment_value | money }} sem juros
        </div>

        {% comment %} Formulário de variantes {% endcomment %}
        <form class="pdp__form" id="product-form" action="/cart/add" method="post">
          <input type="hidden" name="id" id="variant-id" value="{{ variant.id }}" />

          {% for option in product.options_with_values %}
            {% assign option_name_down = option.name | downcase %}

            {% if option_name_down == 'cor' or option_name_down == 'color' %}
              {% comment %} Cor – swatches {% endcomment %}
              <fieldset class="pdp__option">
                <legend class="pdp__option-label">{{ option.name }}: <span class="pdp__option-value" data-option-index="{{ forloop.index0 }}">{{ option.selected_value | default: option.values.first }}</span></legend>
                <div class="pdp__swatches">
                  {% for value in option.values %}
                    <label class="pdp__swatch" title="{{ value }}">
                      <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" {% if forloop.first %}checked{% endif %} />
                      <span class="pdp__swatch-circle" style="background-color: {{ value | downcase | replace: ' ', '' }};"></span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>

            {% elsif option_name_down == 'tamanho' or option_name_down == 'size' %}
              {% comment %} Tamanho – pills {% endcomment %}
              <fieldset class="pdp__option">
                <legend class="pdp__option-label">{{ option.name }}</legend>
                <div class="pdp__sizes">
                  {% for value in option.values %}
                    <label class="pdp__size-pill">
                      <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" {% if forloop.first %}checked{% endif %} />
                      <span class="pdp__size-label">{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>

            {% else %}
              {% comment %} Outras opções – select {% endcomment %}
              <fieldset class="pdp__option">
                <legend class="pdp__option-label">{{ option.name }}</legend>
                <select name="options[{{ option.name }}]" class="pdp__select">
                  {% for value in option.values %}
                    <option value="{{ value }}" {% if forloop.first %}selected{% endif %}>{{ value }}</option>
                  {% endfor %}
                </select>
              </fieldset>
            {% endif %}
          {% endfor %}

          {% comment %} Botão comprar {% endcomment %}
          <button type="submit" class="pdp__add-to-cart" id="add-to-cart-btn"
            {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}
              ADICIONAR À SACOLA
            {% else %}
              ESGOTADO
            {% endif %}
          </button>
        </form>

        {% comment %} Links auxiliares {% endcomment %}
        <div class="pdp__aux-links">
          <a href="#" class="pdp__aux-link">Tabela de Medidas</a>
        </div>

        {% comment %} Acordeões {% endcomment %}
        <div class="pdp__accordions">
          <details class="pdp__accordion">
            <summary class="pdp__accordion-trigger">Sobre a peça</summary>
            <div class="pdp__accordion-body">
              {{ product.description }}
            </div>
          </details>

          <details class="pdp__accordion">
            <summary class="pdp__accordion-trigger">Composição</summary>
            <div class="pdp__accordion-body">
              {% if product.metafields.custom.composition %}
                {{ product.metafields.custom.composition }}
              {% else %}
                Consulte a descrição do produto.
              {% endif %}
            </div>
          </details>

          <details class="pdp__accordion">
            <summary class="pdp__accordion-trigger">Envio e Trocas</summary>
            <div class="pdp__accordion-body">
              <p>Frete grátis para compras acima de R$ 499. Trocas em até 30 dias.</p>
            </div>
          </details>
        </div>

        {% comment %} Compartilhar {% endcomment %}
        <div class="pdp__share">
          <button class="pdp__share-btn" id="share-btn" aria-label="Compartilhar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/>
              <polyline points="16 6 12 2 8 6"/>
              <line x1="12" y1="2" x2="12" y2="15"/>
            </svg>
            <span>Compartilhar</span>
          </button>
        </div>

      </div>
    </div>
  </div>

  {% comment %} Recomendações {% endcomment %}
  <section class="pdp__recommendations">
    <h2 class="pdp__recommendations-title">VOCÊ TAMBÉM VAI AMAR</h2>
    <div class="pdp__recommendations-grid">
      {% assign rec_collection = collections['all'] %}
      {% for p in rec_collection.products limit: 8 %}
        {% if p.id != product.id %}
          {% render 'product-card', product: p %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
</div>

<style>
  /* ========================================
     PDP – Página de Produto (estilo BP)
     Medidas conferidas via getComputedStyle
     ======================================== */

  .pdp {
    background: #ffffff;
    padding: 0;
  }

  /* --- Breadcrumb --- */
  .pdp__breadcrumb {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #545454;
    padding: 12px 40px;
    letter-spacing: 0.3px;
  }
  .pdp__breadcrumb a {
    color: #545454;
    text-decoration: none;
  }
  .pdp__breadcrumb a:hover {
    text-decoration: underline;
  }
  .pdp__breadcrumb-sep {
    margin: 0 6px;
    color: #999;
  }

  /* --- Container principal: 50/50 flex --- */
  .pdp__container {
    display: flex;
    width: 100%;
    max-width: 100%;
  }

  /* --- Galeria (esquerda 50%) --- */
  .pdp__gallery {
    width: 50%;
    flex: 0 0 50%;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pdp__gallery-item {
    width: 100%;
  }
  .pdp__gallery-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 2 / 3;
  }

  /* --- Info (direita 50%, sticky) --- */
  .pdp__info-wrapper {
    width: 50%;
    flex: 0 0 50%;
    position: relative;
  }
  .pdp__info {
    position: sticky;
    top: 100px; /* abaixo do header fixo */
    padding: 30px 50px 60px 50px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }
  /* Esconder scrollbar do info quando rola */
  .pdp__info::-webkit-scrollbar {
    width: 0;
    background: transparent;
  }

  /* --- Vendor --- */
  .pdp__vendor {
    font-family: 'Raleway', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 8px;
  }

  /* --- Título --- BP: Raleway 16px, 400, uppercase, 0.6px, #545454 --- */
  .pdp__title {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #545454;
    margin: 0 0 20px 0;
    line-height: 1.4;
  }

  /* --- Preço --- BP: Raleway 16px, 400, #545454 --- */
  .pdp__price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }
  .pdp__price-current {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #545454;
  }
  .pdp__price-current--sale {
    color: #c0392b;
  }
  .pdp__price-original {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #999;
    text-decoration: line-through;
  }

  /* --- Parcelamento --- */
  .pdp__installments {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #999;
    margin-bottom: 28px;
  }

  /* --- Formulário --- */
  .pdp__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
  }

  /* --- Option label --- */
  .pdp__option {
    border: none;
    padding: 0;
    margin: 0;
  }
  .pdp__option-label {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.6px;
    color: #545454;
    margin-bottom: 12px;
    display: block;
    text-transform: uppercase;
  }
  .pdp__option-value {
    font-weight: 400;
    text-transform: none;
  }

  /* --- Color swatches --- */
  .pdp__swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pdp__swatch {
    cursor: pointer;
    display: block;
  }
  .pdp__swatch input {
    display: none;
  }
  .pdp__swatch-circle {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid transparent;
    transition: border-color 0.2s;
  }
  .pdp__swatch input:checked + .pdp__swatch-circle {
    border-color: #545454;
  }

  /* --- Size pills --- BP: clean pill style --- */
  .pdp__sizes {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pdp__size-pill {
    cursor: pointer;
    display: block;
  }
  .pdp__size-pill input {
    display: none;
  }
  .pdp__size-label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 44px;
    padding: 0 16px;
    border: 1px solid rgba(84, 84, 84, 0.25);
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #545454;
    letter-spacing: 0.3px;
    transition: all 0.2s;
    background: #ffffff;
  }
  .pdp__size-pill input:checked + .pdp__size-label {
    border-color: #545454;
    background: #545454;
    color: #ffffff;
  }
  .pdp__size-label:hover {
    border-color: #545454;
  }

  /* --- Select (outras opções) --- */
  .pdp__select {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid rgba(84, 84, 84, 0.25);
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    color: #545454;
    background: #ffffff;
    appearance: none;
    cursor: pointer;
  }

  /* --- Botão Adicionar à Sacola --- BP: bg rgb(217,200,158), cor #545454, 47px --- */
  .pdp__add-to-cart {
    width: 100%;
    height: 47px;
    background: rgb(217, 200, 158);
    color: #545454;
    border: none;
    border-radius: 0;
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .pdp__add-to-cart:hover:not(:disabled) {
    opacity: 0.85;
  }
  .pdp__add-to-cart:disabled {
    background: #e0dcd4;
    color: #999;
    cursor: not-allowed;
  }

  /* --- Links auxiliares --- */
  .pdp__aux-links {
    padding: 16px 0;
  }
  .pdp__aux-link {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #545454;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pdp__aux-link:hover {
    color: #333;
  }

  /* --- Acordeões --- BP: borda top rgba(84,84,84,0.2), summary 16px Raleway --- */
  .pdp__accordions {
    margin-top: 24px;
  }
  .pdp__accordion {
    border-top: 1px solid rgba(84, 84, 84, 0.2);
  }
  .pdp__accordion:last-child {
    border-bottom: 1px solid rgba(84, 84, 84, 0.2);
  }
  .pdp__accordion-trigger {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.6px;
    color: #545454;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  .pdp__accordion-trigger::-webkit-details-marker {
    display: none;
  }
  .pdp__accordion-trigger::after {
    content: '+';
    font-size: 20px;
    font-weight: 300;
    color: #545454;
    transition: transform 0.25s;
  }
  details[open] > .pdp__accordion-trigger::after {
    content: '−';
  }
  .pdp__accordion-body {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7;
    color: #545454;
    padding: 0 0 20px 0;
  }

  /* --- Compartilhar --- */
  .pdp__share {
    margin-top: 20px;
    padding-top: 16px;
  }
  .pdp__share-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #545454;
    cursor: pointer;
    padding: 0;
    letter-spacing: 0.3px;
  }
  .pdp__share-btn:hover {
    color: #333;
  }

  /* --- Recomendações --- */
  .pdp__recommendations {
    padding: 60px 40px;
    background: #ffffff;
  }
  .pdp__recommendations-title {
    font-family: 'Italiana', 'Cormorant Garamond', Georgia, serif;
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    text-align: center;
    color: #B3883D;
    margin: 0 0 40px 0;
    line-height: 1.3;
  }
  .pdp__recommendations-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px 12px;
  }

  /* ===========================
     MOBILE / TABLET
     =========================== */

  @media (max-width: 1024px) {
    .pdp__container {
      flex-direction: column;
    }
    .pdp__gallery {
      width: 100%;
      flex: none;
      /* No mobile, galeria vira scroll horizontal */
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0;
    }
    .pdp__gallery-item {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }
    .pdp__gallery-img {
      aspect-ratio: 3 / 4;
    }
    .pdp__info-wrapper {
      width: 100%;
      flex: none;
    }
    .pdp__info {
      position: static;
      padding: 24px 20px 40px;
      max-height: none;
      overflow-y: visible;
    }
    .pdp__recommendations-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 8px;
    }
    .pdp__recommendations {
      padding: 40px 20px;
    }
  }

  @media (max-width: 480px) {
    .pdp__breadcrumb {
      padding: 10px 16px;
      font-size: 12px;
    }
    .pdp__info {
      padding: 20px 16px 40px;
    }
    .pdp__recommendations-title {
      font-size: 26px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    /* ---- Variant selection logic ---- */
    const productJson = {{ product | json }};
    const variantIdInput = document.getElementById('variant-id');
    const addBtn = document.getElementById('add-to-cart-btn');
    const form = document.getElementById('product-form');

    function getSelectedOptions() {
      const opts = {};
      form.querySelectorAll('input[type="radio"]:checked, select').forEach(el => {
        const name = el.name.replace('options[', '').replace(']', '');
        opts[name] = el.value;
      });
      return opts;
    }

    function findVariant(opts) {
      return productJson.variants.find(v => {
        return productJson.options.every((optName, i) => {
          return v.options[i] === opts[optName];
        });
      });
    }

    function updateVariant() {
      const opts = getSelectedOptions();
      const variant = findVariant(opts);
      if (variant) {
        variantIdInput.value = variant.id;
        // Update price
        const priceEl = document.querySelector('.pdp__price-current');
        if (priceEl) {
          priceEl.textContent = (variant.price / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }
        // Update compare price
        const origEl = document.querySelector('.pdp__price-original');
        if (origEl) {
          if (variant.compare_at_price && variant.compare_at_price > variant.price) {
            origEl.textContent = (variant.compare_at_price / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            origEl.style.display = '';
          } else {
            origEl.style.display = 'none';
          }
        }
        // Update installments
        const instEl = document.querySelector('.pdp__installments');
        if (instEl) {
          const instVal = (variant.price / 100 / 6).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
          instEl.textContent = 'ou 6x de ' + instVal + ' sem juros';
        }
        // Button state
        if (variant.available) {
          addBtn.disabled = false;
          addBtn.textContent = 'ADICIONAR À SACOLA';
        } else {
          addBtn.disabled = true;
          addBtn.textContent = 'ESGOTADO';
        }
        // Update URL
        const url = new URL(window.location);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url);
      }
    }

    // Listen to option changes
    form.querySelectorAll('input[type="radio"], select').forEach(el => {
      el.addEventListener('change', function() {
        updateVariant();
        // Update option value display
        if (this.type === 'radio') {
          const legend = this.closest('fieldset').querySelector('.pdp__option-value');
          if (legend) legend.textContent = this.value;
        }
      });
    });

    /* ---- Add to cart ---- */
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      addBtn.disabled = true;
      addBtn.textContent = 'ADICIONANDO...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{ id: parseInt(variantIdInput.value), quantity: 1 }]
        })
      })
      .then(res => {
        if (!res.ok) throw new Error('Erro');
        return res.json();
      })
      .then(() => {
        addBtn.textContent = 'ADICIONADO ✓';
        setTimeout(() => {
          addBtn.disabled = false;
          addBtn.textContent = 'ADICIONAR À SACOLA';
        }, 2000);
      })
      .catch(() => {
        addBtn.disabled = false;
        addBtn.textContent = 'ADICIONAR À SACOLA';
        alert('Erro ao adicionar ao carrinho. Tente novamente.');
      });
    });

    /* ---- Share ---- */
    document.getElementById('share-btn')?.addEventListener('click', function() {
      if (navigator.share) {
        navigator.share({ title: productJson.title, url: window.location.href });
      } else {
        navigator.clipboard.writeText(window.location.href).then(() => {
          const span = this.querySelector('span');
          span.textContent = 'Link copiado!';
          setTimeout(() => { span.textContent = 'Compartilhar'; }, 2000);
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Mostrar breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_recommendations",
      "label": "Mostrar recomendações",
      "default": true
    }
  ]
}
{% endschema %}
