{% comment %}
  Cart page section - main-cart.liquid
{% endcomment %}

<div class="cart-page">
  <h1 class="cart-title">SACOLA DE COMPRAS</h1>

  {% if cart.item_count > 0 %}
    <div class="cart-container">
      <div class="cart-items">
        <table class="cart-table">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Preço</th>
              <th>Quantidade</th>
              <th>Subtotal</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart-item" data-line="{{ forloop.index }}">
                <td class="cart-item__product">
                  {% if item.featured_image %}
                    <a href="{{ item.url }}">
                      <img src="{{ item.featured_image | image_url: width: 100 }}" alt="{{ item.title }}" />
                    </a>
                  {% endif %}
                  <div>
                    <a href="{{ item.url }}" class="cart-item__title">{{ item.title }}</a>
                    {% if item.variant.title != 'Default Title' %}
                      <div class="cart-item__variant">{{ item.variant.title }}</div>
                    {% endif %}
                  </div>
                </td>
                <td class="cart-item__price">{{ item.price | money_with_currency }}</td>
                <td class="cart-item__quantity">
                  <div class="quantity-selector">
                    <button class="quantity-btn" data-action="decrease">-</button>
                    <input type="number" min="1" value="{{ item.quantity }}" class="quantity-input" data-line="{{ forloop.index }}" />
                    <button class="quantity-btn" data-action="increase">+</button>
                  </div>
                </td>
                <td class="cart-item__subtotal">{{ item.final_line_price | money_with_currency }}</td>
                <td class="cart-item__remove">
                  <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="btn-remove">×</a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <aside class="cart-summary">
        <div class="summary-section">
          <h3>RESUMO DO PEDIDO</h3>

          <div class="summary-row">
            <span>Subtotal:</span>
            <span>{{ cart.subtotal_price | money_with_currency }}</span>
          </div>

          {% if cart.total_discount > 0 %}
            <div class="summary-row discount">
              <span>Desconto:</span>
              <span>-{{ cart.total_discount | money_with_currency }}</span>
            </div>
          {% endif %}

          <div class="summary-row">
            <span>Frete:</span>
            <span id="shipping-cost">Calcular</span>
          </div>

          <div class="summary-row total">
            <span>Total:</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>

          <button class="btn btn--primary btn--checkout" onclick="window.location.href='/checkout'">
            PROSSEGUIR PARA O PAGAMENTO
          </button>

          <a href="/collections/all" class="btn btn--secondary">CONTINUAR COMPRANDO</a>
        </div>

        {% comment %} Coupon Section {% endcomment %}
        <div class="summary-section">
          <form id="coupon-form" class="coupon-form">
            <label for="coupon">Código de desconto:</label>
            <div class="coupon-input-group">
              <input type="text" id="coupon" name="coupon" placeholder="Insira seu código" />
              <button type="submit" class="btn--small">APLICAR</button>
            </div>
          </form>
        </div>
      </aside>
    </div>
  {% else %}
    <div class="cart-empty">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <circle cx="9" cy="21" r="1"/>
        <circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <h2>Sua sacola está vazia</h2>
      <p>Que tal explorar nossa coleção?</p>
      <a href="/collections/all" class="btn btn--primary">VOLTAR ÀS COMPRAS</a>
    </div>
  {% endif %}
</div>

<style>
  .cart-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .cart-title {
    font-family: 'Noto Serif', serif;
    font-size: 42px;
    font-weight: 400;
    letter-spacing: 2px;
    margin: 0 0 40px 0;
    text-transform: uppercase;
  }

  .cart-container {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 40px;
  }

  .cart-items {
    overflow-x: auto;
  }

  .cart-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .cart-table th {
    text-align: left;
    padding: 15px;
    border-bottom: 1px solid #e0e0e0;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cart-table td {
    padding: 20px 15px;
    border-bottom: 1px solid #e0e0e0;
    vertical-align: middle;
  }

  .cart-item__product {
    display: flex;
    gap: 15px;
  }

  .cart-item__product img {
    width: 80px;
    height: 80px;
    object-fit: cover;
  }

  .cart-item__title {
    display: block;
    color: #000;
    text-decoration: none;
    font-weight: 500;
    margin-bottom: 5px;
  }

  .cart-item__title:hover {
    text-decoration: underline;
  }

  .cart-item__variant {
    font-size: 12px;
    color: #999;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #e0e0e0;
    width: fit-content;
  }

  .quantity-btn {
    width: 30px;
    height: 30px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    border-right: 1px solid #e0e0e0;
  }

  .quantity-btn:last-of-type {
    border-right: none;
    border-left: 1px solid #e0e0e0;
  }

  .quantity-input {
    width: 50px;
    border: none;
    text-align: center;
    font-size: 14px;
  }

  .btn-remove {
    color: #999;
    font-size: 24px;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .btn-remove:hover {
    color: #000;
  }

  .cart-summary {
    background: #f9f9f9;
    padding: 30px;
    height: fit-content;
    position: sticky;
    top: 20px;
  }

  .summary-section {
    margin-bottom: 30px;
    padding-bottom: 30px;
    border-bottom: 1px solid #e0e0e0;
  }

  .summary-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .summary-section h3 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    margin: 0 0 20px 0;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    margin-bottom: 10px;
  }

  .summary-row.discount span:last-child {
    color: #27ae60;
    font-weight: 600;
  }

  .summary-row.total {
    font-weight: 600;
    font-size: 16px;
    padding-top: 10px;
    border-top: 1px solid #e0e0e0;
    margin-top: 10px;
  }

  .btn--checkout {
    width: 100%;
    margin-bottom: 10px;
  }

  .btn--secondary {
    display: block;
    text-align: center;
    width: 100%;
    background: transparent;
    border: 1px solid #000;
    padding: 10px;
    cursor: pointer;
    text-decoration: none;
    color: #000;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn--secondary:hover {
    background: #000;
    color: #fff;
  }

  .coupon-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .coupon-form label {
    font-size: 12px;
    font-weight: 600;
  }

  .coupon-input-group {
    display: flex;
    gap: 8px;
  }

  .coupon-input-group input {
    flex: 1;
    padding: 8px;
    border: 1px solid #e0e0e0;
    font-size: 12px;
  }

  .btn--small {
    padding: 8px 12px;
    background: #000;
    color: #fff;
    border: none;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
  }

  .cart-empty {
    text-align: center;
    padding: 60px 20px;
  }

  .cart-empty svg {
    color: #ddd;
    margin-bottom: 20px;
  }

  .cart-empty h2 {
    font-size: 28px;
    margin: 20px 0;
  }

  .cart-empty p {
    font-size: 16px;
    color: #666;
    margin: 10px 0 30px 0;
  }

  @media (max-width: 768px) {
    .cart-container {
      grid-template-columns: 1fr;
    }

    .cart-summary {
      position: static;
    }

    .cart-table {
      font-size: 12px;
    }

    .cart-table th,
    .cart-table td {
      padding: 10px 5px;
    }

    .cart-item__product {
      flex-direction: column;
      gap: 10px;
    }

    .cart-item__product img {
      width: 60px;
      height: 60px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const quantityButtons = document.querySelectorAll('.quantity-btn');
    const quantityInputs = document.querySelectorAll('.quantity-input');

    quantityButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const action = this.dataset.action;
        const input = this.closest('.quantity-selector').querySelector('.quantity-input');
        let value = parseInt(input.value) || 1;

        if (action === 'increase') {
          value++;
        } else if (action === 'decrease' && value > 1) {
          value--;
        }

        input.value = value;
        updateCart(input.dataset.line, value);
      });
    });

    quantityInputs.forEach(input => {
      input.addEventListener('change', function() {
        const value = parseInt(this.value) || 1;
        updateCart(this.dataset.line, value);
      });
    });

    function updateCart(line, quantity) {
      fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          line: line,
          quantity: quantity
        })
      }).then(response => response.json())
        .then(() => location.reload())
        .catch(error => console.error('Error:', error));
    }

    {% comment %} Coupon form {% endcomment %}
    document.getElementById('coupon-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const coupon = document.getElementById('coupon').value;
      const url = new URL(window.location);
      url.searchParams.set('discount', coupon);
      window.location.href = url.toString();
    });
  });
</script>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
