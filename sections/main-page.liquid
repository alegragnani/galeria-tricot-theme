{% comment %}
  Generic page section - main-page.liquid
{% endcomment %}

<div class="page-content">
  <article class="page-article">
    {% if page.title %}
      <h1 class="page-title">{{ page.title }}</h1>
    {% endif %}

    <div class="page-body">
      {{ page.content }}
    </div>
  </article>
</div>

<style>
  .page-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .page-article {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font-family: 'Italiana', 'Cormorant Garamond', Georgia, serif;
    font-size: 42px;
    font-weight: 400;
    letter-spacing: 2px;
    margin: 0 0 40px 0;
    text-transform: uppercase;
  }

  .page-body {
    font-size: 16px;
    line-height: 1.8;
    color: #555;
  }

  .page-body h2 {
    font-size: 24px;
    margin-top: 40px;
    margin-bottom: 20px;
  }

  .page-body p {
    margin-bottom: 20px;
  }

  .page-body a {
    color: #000;
    text-decoration: underline;
  }

  .page-body a:hover {
    color: #666;
  }

  @media (max-width: 768px) {
    .page-content {
      padding: 30px 20px;
    }

    .page-title {
      font-size: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Page"
}
{% endschema %}
