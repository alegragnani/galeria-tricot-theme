<!-- Image Banner Section — configuravel pelo editor -->
<section class="image-banner">
  <div class="image-banner__wrapper">
    {% if section.settings.image %}
      {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" class="image-banner__link-wrap" aria-label="{{ section.settings.heading | default: 'Ver produtos' }}">{%- endif -%}
      <picture>
        {% if section.settings.image_mobile %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 900 }}"
          >
        {% endif %}
        <img
          src="{{ section.settings.image | image_url: width: 1920 }}"
          alt="{{ section.settings.heading }}"
          class="image-banner__image"
          loading="lazy"
        >
      </picture>
      {%- if section.settings.link != blank -%}</a>{%- endif -%}
    {% else %}
      <div class="image-banner__placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if section.settings.heading or section.settings.subtitle or section.settings.link_text %}
      <div class="image-banner__overlay image-banner__overlay--{{ section.settings.text_position }} image-banner__overlay--{{ section.settings.text_vertical }}">
        <div class="image-banner__content">
          {% if section.settings.subtitle != blank %}
            <p class="image-banner__subtitle" style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.subtitle_size }}px;">
              {{ section.settings.subtitle }}
            </p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="image-banner__heading" style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.heading_size }}px;">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.link_text != blank and section.settings.link != blank %}
            <a href="{{ section.settings.link }}" class="image-banner__link" style="color: {{ section.settings.text_color }}; border-color: {{ section.settings.text_color }};">
              {{ section.settings.link_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .image-banner__link-wrap { display: block; width: 100%; height: 100%; cursor: pointer; }
  .image-banner__link-wrap picture { display: block; width: 100%; height: 100%; }
  .image-banner__overlay { pointer-events: none; }
  .image-banner__overlay a { pointer-events: auto; }

  .image-banner {
    width: 100%;
    padding: 0;
    margin: 0 0 3px 0;
    overflow: hidden;
  }

  .image-banner__wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .image-banner__image,
  .image-banner__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Sem efeito de zoom no hover — estático */
  }

  .image-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    z-index: 2;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.05) 100%);
  }

  /* Horizontal */
  .image-banner__overlay--left {
    justify-content: flex-start;
    padding-left: 5%;
  }

  .image-banner__overlay--center {
    justify-content: center;
    text-align: center;
  }

  .image-banner__overlay--right {
    justify-content: flex-end;
    padding-right: 5%;
  }

  /* Vertical */
  .image-banner__overlay--top {
    align-items: flex-start;
    padding-top: 8%;
  }

  .image-banner__overlay--middle {
    align-items: center;
  }

  .image-banner__overlay--bottom {
    align-items: flex-end;
    padding-bottom: 8%;
  }

  .image-banner__content {
    max-width: 500px;
  }

  .image-banner__subtitle {
    font-family: 'Raleway', -apple-system, sans-serif;
    font-weight: 400;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
  }

  .image-banner__heading {
    font-family: 'Italiana', 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 1.5rem 0;
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }

  .image-banner__link {
    display: inline-flex;
    align-items: center;
    font-family: 'Raleway', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid;
    padding: 12px 28px;
  }

  .image-banner__link:hover {
    background-color: #ffffff;
    color: #545454 !important;
    border-color: #ffffff !important;
  }

  @media (max-width: 768px) {
    .image-banner__wrapper {
      aspect-ratio: 9 / 16.6; /* BP mobile */
    }

    .image-banner__overlay--left {
      padding-left: 2rem;
    }

    .image-banner__overlay--right {
      padding-right: 2rem;
    }

    .image-banner__heading {
      font-size: clamp(1.25rem, 6vw, 2.5rem) !important;
    }

    .image-banner__subtitle {
      font-size: 13px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Image Banner",
  "settings": [
    {
      "type": "header",
      "content": "Imagens"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagem mobile"
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo (texto menor em cima)",
      "default": "CONFIRA"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Tamanho do subtítulo (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal",
      "default": "NOVA COLEÇÃO"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamanho do título (px)",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 48
    },
    {
      "type": "header",
      "content": "Botão"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Texto do botão",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link do botão"
    },
    {
      "type": "header",
      "content": "Posição e cor"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Posição horizontal",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_vertical",
      "label": "Posição vertical",
      "options": [
        { "value": "top", "label": "Topo" },
        { "value": "middle", "label": "Meio" },
        { "value": "bottom", "label": "Embaixo" }
      ],
      "default": "middle"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor dos textos",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Image Banner"
    }
  ]
}
{% endschema %}
