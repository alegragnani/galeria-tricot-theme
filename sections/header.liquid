<script>
  document.addEventListener('DOMContentLoaded', function() {
    const header = document.querySelector('[data-site-header]');
    if (!header) return;

    // ===== Scroll direction: hide/reveal igual BP =====
    let lastScrollY = window.scrollY;
    let ticking = false;
    const SCROLL_THRESHOLD = 60; // px antes de ativar sticky
    const ANNOUNCEMENT_HEIGHT = 39; // altura da barra de anúncio

    function onScroll() {
      const currentY = window.scrollY;

      // Top dinâmico: header acompanha a barra de anúncio suavemente
      const dynamicTop = Math.max(0, ANNOUNCEMENT_HEIGHT - currentY);
      header.style.top = dynamicTop + 'px';

      // Perto do topo: estado transparente original
      if (currentY <= 5) {
        header.classList.remove('is-scrolled', 'is-hidden', 'is-revealing');
        lastScrollY = currentY;
        updateDrawerTop();
        return;
      }

      // Qualquer scroll > 5px: header sólido branco (NUNCA volta pra transparente no meio da página)
      header.classList.add('is-scrolled');

      // Direção do scroll (dead zone de 8px pra evitar bounce)
      if (currentY > lastScrollY + 8) {
        // Scroll pra BAIXO → some instantâneo
        header.classList.remove('is-revealing');
        header.classList.add('is-hidden');
        lastScrollY = currentY;
      } else if (currentY < lastScrollY - 8) {
        // Scroll pra CIMA → reaparece suave
        header.classList.add('is-revealing');
        header.classList.remove('is-hidden');
        lastScrollY = currentY;
      }
      // Se dentro da dead zone (±8px), não muda nada — evita bouncing

      updateDrawerTop();
    }

    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() {
          onScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Atualizar drawer panel top conforme header se move
    const drawerPanel = document.querySelector('.mobile-drawer__panel');
    function updateDrawerTop() {
      if (drawerPanel) {
        const headerBottom = header.getBoundingClientRect().bottom;
        drawerPanel.style.top = headerBottom + 'px';
        drawerPanel.style.height = 'calc(100% - ' + headerBottom + 'px)';
      }
    }

    // Estado inicial
    onScroll();
    updateDrawerTop();

    // Close mega menus when clicking outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('[data-site-nav]')) {
        const menus = document.querySelectorAll('[data-mega-menu]');
        menus.forEach(menu => {
          menu.parentElement?.classList.remove('is-open');
        });
      }
    });

    // Handle mega menu triggers on mobile
    const triggers = document.querySelectorAll('[data-mega-menu-trigger]');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        const isMobile = window.innerWidth < 992;
        if (isMobile) {
          e.preventDefault();
          const menu = this.parentElement.querySelector('[data-mega-menu]');
          if (menu) {
            this.parentElement.classList.toggle('is-open');
            menu.style.opacity = menu.style.opacity === '1' ? '0' : '1';
            menu.style.visibility = menu.style.visibility === 'visible' ? 'hidden' : 'visible';
          }
        }
      });
    });

    // ===== Mobile Drawer (abre/fecha) =====
    const drawer = document.querySelector('[data-mobile-drawer]');
    const toggleBtn = document.querySelector('[data-menu-toggle]');
    const closeBtns = document.querySelectorAll('[data-drawer-close]');

    function openDrawer() {
      if (!drawer) return;
      // Forçar header visível antes de abrir o drawer
      header.classList.remove('is-hidden');
      header.classList.add('is-scrolled', 'is-revealing');
      // Esperar o header se posicionar, depois abrir o drawer
      requestAnimationFrame(function() {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.classList.add('drawer-open');
        updateDrawerTop();
      });
    }
    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('drawer-open');
    }
    if (toggleBtn) toggleBtn.addEventListener('click', function() {
      if (drawer && drawer.classList.contains('is-open')) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });
    closeBtns.forEach(btn => btn.addEventListener('click', closeDrawer));
    // Fechar com ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });

    // ===== Submenu toggle (seta E link expandem/colapsam) =====
    document.querySelectorAll('.mobile-drawer__item.has-submenu').forEach(function(item) {
      // Clicar no link ou na seta expande o submenu (não navega)
      var link = item.querySelector('.mobile-drawer__link');
      var btn = item.querySelector('[data-submenu-toggle]');
      function toggleSubmenu(e) {
        e.preventDefault();
        item.classList.toggle('is-open');
      }
      if (link) link.addEventListener('click', toggleSubmenu);
      if (btn) btn.addEventListener('click', toggleSubmenu);
    });

    // ===== Search Bar (full-width, estilo BP) =====
    const searchBar = document.getElementById('search-overlay');
    const searchInput = document.getElementById('search-input');
    const searchResults = document.getElementById('search-results');
    const searchBtns = document.querySelectorAll('[data-search-btn]');
    const searchCloseBtns = document.querySelectorAll('[data-search-close]');
    const clearRecentBtn = document.getElementById('search-clear-recent');
    let searchTimer = null;
    let suggestionsHTML = ''; // guarda HTML original (sugestões + recentes)

    function openSearch() {
      if (!searchBar) return;
      loadRecentSearches();
      suggestionsHTML = searchResults.innerHTML;
      searchBar.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      setTimeout(() => { if (searchInput) searchInput.focus(); }, 150);
    }
    function closeSearch() {
      if (!searchBar) return;
      searchBar.classList.remove('is-open');
      document.body.style.overflow = '';
      if (searchInput) searchInput.value = '';
      searchResults.innerHTML = suggestionsHTML;
    }

    searchBtns.forEach(btn => btn.addEventListener('click', openSearch));
    searchCloseBtns.forEach(btn => btn.addEventListener('click', closeSearch));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && searchBar && searchBar.classList.contains('is-open')) closeSearch();
    });

    // Buscas recentes (in-memory, não usa localStorage)
    var recentSearches = [];
    try { recentSearches = JSON.parse(sessionStorage.getItem('gt_recent') || '[]'); } catch(e) {}

    function saveRecentSearch(q) {
      if (!q) return;
      recentSearches = recentSearches.filter(s => s !== q);
      recentSearches.unshift(q);
      if (recentSearches.length > 5) recentSearches = recentSearches.slice(0, 5);
      try { sessionStorage.setItem('gt_recent', JSON.stringify(recentSearches)); } catch(e) {}
    }

    function loadRecentSearches() {
      const list = document.getElementById('search-recent-list');
      if (!list) return;
      if (recentSearches.length === 0) {
        list.innerHTML = '<li style="color:#999;font-size:13px;padding:8px 0;">Nenhuma busca recente</li>';
      } else {
        list.innerHTML = recentSearches.map(q =>
          '<li><a href="/search?q=' + encodeURIComponent(q) + '&type=product">' + q + '</a></li>'
        ).join('');
      }
    }

    if (clearRecentBtn) clearRecentBtn.addEventListener('click', function() {
      recentSearches = [];
      try { sessionStorage.removeItem('gt_recent'); } catch(e) {}
      loadRecentSearches();
      suggestionsHTML = searchResults.innerHTML;
    });

    // Live search (predictive search API do Shopify)
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        clearTimeout(searchTimer);
        const q = this.value.trim();
        if (q.length < 2) {
          searchResults.innerHTML = suggestionsHTML;
          return;
        }
        searchTimer = setTimeout(() => fetchSearch(q), 300);
      });
      // Salvar busca ao submeter
      searchInput.closest('form').addEventListener('submit', function() {
        saveRecentSearch(searchInput.value.trim());
      });
    }

    async function fetchSearch(query) {
      try {
        const resp = await fetch('/search/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product&resources[limit]=6');
        const data = await resp.json();
        const products = data.resources?.results?.products || [];
        renderSearchResults(products, query);
      } catch(e) {
        searchResults.innerHTML = '<div class="search-bar__no-results">Erro na busca</div>';
      }
    }

    function renderSearchResults(products, query) {
      if (products.length === 0) {
        searchResults.innerHTML = '<div class="search-bar__no-results">Nenhum produto encontrado para "' + query + '"</div>';
        return;
      }
      let html = '<div class="search-bar__live-results">';
      products.forEach(p => {
        const img = p.image || p.featured_image?.url || '';
        const price = p.price ? ('R$ ' + (parseFloat(p.price) / 100).toFixed(2).replace('.', ',')) : '';
        html += '<a href="' + p.url + '" class="search-bar__result-item">';
        if (img) html += '<img src="' + img + '" alt="" class="search-bar__result-img" loading="lazy">';
        html += '<div class="search-bar__result-info">';
        html += '<div class="search-bar__result-title">' + p.title + '</div>';
        if (price) html += '<div class="search-bar__result-price">' + price + '</div>';
        html += '</div></a>';
      });
      html += '</div>';
      html += '<a href="/search?q=' + encodeURIComponent(query) + '&type=product" class="search-bar__view-all">Ver todos os resultados</a>';
      searchResults.innerHTML = html;
    }
  });
</script>

