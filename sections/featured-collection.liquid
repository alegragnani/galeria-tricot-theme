<!-- Featured Collection Section -->
<section class="featured-collection">
  <div class="featured-collection__header">
    {% if section.settings.title %}
      <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
    {% endif %}
  </div>

  <div class="featured-collection__carousel" data-carousel>
    <div class="featured-collection__track">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: 12 %}
          <div class="featured-collection__item">
            {% render 'product-card', product: product %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap');

  .featured-collection {
    padding: 4rem 2rem;
    position: relative;
    background: transparent;
  }

  .featured-collection__header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .featured-collection__title {
    font-family: 'Raleway', -apple-system, sans-serif;
    font-size: 32px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin: 0;
    color: #9E885E;
    line-height: 1.2;
  }

  .featured-collection__carousel {
    position: relative;
    overflow: hidden;
  }

  .featured-collection__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 1rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
  }

  .featured-collection__track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .featured-collection__track::-webkit-scrollbar {
    display: none;
  }

  .featured-collection__item {
    flex: 0 0 calc(25% - 1.125rem);
    min-width: 200px;
  }

  @media (max-width: 1024px) {
    .featured-collection__item {
      flex: 0 0 calc(33.333% - 1rem);
    }
  }

  @media (max-width: 768px) {
    .featured-collection {
      padding: 3rem 1rem;
    }

    .featured-collection__item {
      flex: 0 0 calc(50% - 0.75rem);
    }

    .featured-collection__header {
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 480px) {
    .featured-collection__item {
      flex: 0 0 calc(100% - 0rem);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-carousel]').forEach(function(carousel) {
      const track = carousel.querySelector('.featured-collection__track');
      if (!track) return;

      let isDown = false;
      let startX = 0;
      let startScroll = 0;

      track.addEventListener('mousedown', function(e) {
        isDown = true;
        track.classList.add('is-dragging');
        startX = e.pageX - track.offsetLeft;
        startScroll = track.scrollLeft;
      });
      track.addEventListener('mouseleave', function() {
        isDown = false;
        track.classList.remove('is-dragging');
      });
      track.addEventListener('mouseup', function() {
        isDown = false;
        track.classList.remove('is-dragging');
      });
      track.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        track.scrollLeft = startScroll - (x - startX);
      });
      // Evitar clicar num produto logo após arrastar
      track.addEventListener('click', function(e) {
        if (track.classList.contains('was-dragged')) {
          e.preventDefault();
          e.stopPropagation();
          track.classList.remove('was-dragged');
        }
      }, true);
      track.addEventListener('mousemove', function() {
        if (isDown) track.classList.add('was-dragged');
      });
    });
  });
</script>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
