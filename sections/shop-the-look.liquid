<!-- Escolhas das Blogueiras — layout BP "Escolhas da Pat" -->
<section class="shop-the-look">
  {% if section.settings.title != blank %}
    <div class="shop-the-look__header">
      <h2 class="shop-the-look__section-title">{{ section.settings.title }}</h2>
    </div>
  {% endif %}

  <div class="shop-the-look__container">
    <div class="shop-the-look__grid">
      <!-- Esquerda: Foto lifestyle retrato -->
      <div class="shop-the-look__lifestyle">
        {% if section.settings.lifestyle_image %}
          <img
            src="{{ section.settings.lifestyle_image | image_url: width: 900 }}"
            srcset="{{ section.settings.lifestyle_image | image_url: width: 600 }} 600w, {{ section.settings.lifestyle_image | image_url: width: 900 }} 900w, {{ section.settings.lifestyle_image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 749px) 100vw, 50vw"
            alt="{{ section.settings.title | escape }}"
            class="shop-the-look__lifestyle-image"
            loading="lazy"
          >
        {% else %}
          <div class="shop-the-look__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <!-- Direita: Produto com moldura -->
      <div class="shop-the-look__product-side">
        {% if section.settings.product != blank %}
          {% assign product = section.settings.product %}
          <div class="shop-the-look__card-frame">
            <a href="{{ product.url }}" class="shop-the-look__product-link">
              <div class="shop-the-look__product-image-wrapper">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.title | escape }}"
                    class="shop-the-look__product-image"
                    loading="lazy"
                  >
                {% endif %}

                <!-- Hover: Adicionar à sacola -->
                <div class="shop-the-look__quick-add">
                  <span class="shop-the-look__quick-add-text">Adicionar à sacola</span>
                </div>
              </div>

              <div class="shop-the-look__product-info">
                <h3 class="shop-the-look__product-title">{{ product.title }}</h3>
                <div class="shop-the-look__product-price">
                  {% if product.compare_at_price > product.price %}
                    <span class="shop-the-look__price--compare">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                  <span class="shop-the-look__price">{{ product.price | money }}</span>
                </div>
              </div>
            </a>
          </div>
        {% else %}
          <div class="shop-the-look__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .shop-the-look {
    padding: 12px 0 36px;
    margin: 0;
    background-color: #ffffff;
  }

  .shop-the-look__header {
    text-align: center;
    padding: 0 50px 1.5rem;
    max-width: 1600px;
    margin: 0 auto;
  }

  .shop-the-look__section-title {
    font-family: 'Italiana', 'Cormorant Garamond', Georgia, serif;
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #9E885E;
    margin: 0;
    line-height: 1.3;
  }

  /* Container com margem lateral igual BP */
  .shop-the-look__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 50px;
  }

  /* Grid 2 colunas 50/50, gap 8px (BP) */
  .shop-the-look__grid {
    display: flex;
    gap: 8px;
  }

  /* Esquerda: lifestyle 50% */
  .shop-the-look__lifestyle {
    flex: 1;
    overflow: hidden;
  }

  .shop-the-look__lifestyle-image {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    display: block;
  }

  .shop-the-look__placeholder {
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Direita: produto 50%, centralizado */
  .shop-the-look__product-side {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Moldura do produto (BP: borda dourada sutil + padding) */
  .shop-the-look__card-frame {
    width: 70%;
    max-width: 522px;
    padding: 15px;
    border: 0.67px solid rgba(217, 200, 158, 0.4);
  }

  .shop-the-look__product-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .shop-the-look__product-image-wrapper {
    position: relative;
    overflow: hidden;
    background: rgb(249, 247, 240);
  }

  .shop-the-look__product-image {
    width: 100%;
    display: block;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .shop-the-look__product-link:hover .shop-the-look__product-image {
    transform: scale(1.03);
  }

  /* Hover: "Adicionar à sacola" (BP style) */
  .shop-the-look__quick-add {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.92);
    padding: 8px 12px;
    display: flex;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .shop-the-look__product-link:hover .shop-the-look__quick-add {
    opacity: 1;
  }

  .shop-the-look__quick-add-text {
    font-family: 'Raleway', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #4a4a4a;
  }

  /* Info: titulo + preco (BP specs) */
  .shop-the-look__product-info {
    padding: 12px 0 0;
  }

  .shop-the-look__product-title {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #121212;
    margin: 0 0 6px 0;
    line-height: 1.4;
  }

  .shop-the-look__product-price {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .shop-the-look__price {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #aaaaaa;
  }

  .shop-the-look__price--compare {
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    text-decoration: line-through;
    color: #cccccc;
  }

  /* Tablet */
  @media (max-width: 1349px) {
    .shop-the-look__container {
      padding: 0 32px;
    }

    .shop-the-look__card-frame {
      width: 80%;
    }
  }

  /* Mobile: empilha */
  @media (max-width: 749px) {
    .shop-the-look__grid {
      flex-direction: column;
      gap: 16px;
    }

    .shop-the-look__container {
      padding: 0 16px;
    }

    .shop-the-look__lifestyle-image {
      aspect-ratio: 3 / 4;
    }

    .shop-the-look__placeholder {
      aspect-ratio: 3 / 4;
    }

    .shop-the-look__card-frame {
      width: 100%;
      max-width: none;
    }
  }
</style>

{% schema %}
{
  "name": "Escolhas das Blogueiras",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título da seção",
      "default": "ESCOLHAS DAS BLOGUEIRAS"
    },
    {
      "type": "image_picker",
      "id": "lifestyle_image",
      "label": "Foto da blogueira (lifestyle)",
      "info": "Retrato 9:16. Tamanho ideal: 900×1600px"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produto em destaque"
    }
  ],
  "presets": [
    {
      "name": "Escolhas das Blogueiras"
    }
  ]
}
{% endschema %}
